--- a/packages/app/src/harmony/host-sync.harmony.tsx
+++ b/packages/app/src/harmony/host-sync.harmony.tsx
@@ -30,42 +30,43 @@ function field(payload: unknown, key: string): unknown {
 const visibility = typeof document === "undefined" ? null : installHostVisibility(document);
 if (harmonyHost.hostInfo()?.foreground === false) visibility?.setHostState("background");
 
-harmonyHost.on("lifecycle", (payload) => {
-  const state = field(payload, "state");
-  if (state !== "active" && state !== "background") return;
-  visibility?.setHostState(state);
-  if (state === "active") reportBackgroundDiagnostics();
-});
-
 /**
- * Pings every live connection and reconnects a dead one at once, skipping the backoff timer.
- * A hidden page's own timers can be throttled to once a minute, slower than the relay's idle
- * lease, so while the continuous task holds the app the shell drives this instead.
+ * HarmonyOS freezes a backgrounded app within seconds, and its sockets then go silent without
+ * closing. A daemon that still sees the phone connected, and recently used, hands it an in-app
+ * alert nobody receives instead of pushing. Dropping every connection on the way out makes the
+ * daemon push from the first moment; coming back reconnects at once.
  */
-function keepConnectionsAlive(): void {
-  getHostRuntimeStore().ensureConnectedAll({ verify: true });
+function suspendConnections(): void {
+  const store = getHostRuntimeStore();
+  for (const host of store.getHosts()) store.getClient(host.serverId)?.suspend("App in background");
+}
+
+function resumeConnections(): void {
+  const store = getHostRuntimeStore();
+  for (const host of store.getHosts()) store.getClient(host.serverId)?.resume();
 }
 
-harmonyHost.on("tick", (payload) => {
-  harmonyHost.send("tick.ack", { sentAt: field(payload, "sentAt") });
-  keepConnectionsAlive();
+harmonyHost.on("lifecycle", (payload) => {
+  const state = field(payload, "state");
+  if (state === "background") {
+    // Hidden first, so the last heartbeat says so before the connection goes.
+    visibility?.setHostState("background");
+    suspendConnections();
+  } else if (state === "active") {
+    // Reconnected first, so the foreground's own reconnect check finds clients it may use.
+    resumeConnections();
+    visibility?.setHostState("active");
+  }
 });
 
-// A network switch kills sockets without a close event.
+// A network switch kills sockets without a close event; probe them instead of waiting out a
+// heartbeat timeout.
 harmonyHost.on("network", (payload) => {
-  if (field(payload, "available") === true) keepConnectionsAlive();
+  if (field(payload, "available") === true) {
+    getHostRuntimeStore().ensureConnectedAll({ verify: true });
+  }
 });
 
-/** Whether the page kept running in the background shows up in the device log on every return. */
-function reportBackgroundDiagnostics(): void {
-  void harmonyHost
-    .request("diagnostics")
-    .then((diagnostics) =>
-      harmonyHost.send("log", { level: "info", message: `resumed ${JSON.stringify(diagnostics)}` }),
-    )
-    .catch(() => undefined);
-}
