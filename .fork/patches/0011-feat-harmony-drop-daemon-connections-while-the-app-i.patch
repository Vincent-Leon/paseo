@@ -14,9 +14,9 @@ export const ensureOsNotificationPermission: typeof Base.ensureOsNotificationPer
   requestHarmonyNotificationPermission();
 
 /**
- * HarmonyOS has no push for Paseo, so every alert the page decides to show is a local
- * notification from the shell. In the background that only happens while the continuous task
- * keeps the page alive; without it the system freezes the page and nothing runs at all.
+ * Alerts the page decides to show while Paseo is open become local notifications from the shell.
+ * Once the app is in the background the page is frozen and its connections are dropped; the
+ * daemon pushes through Push Kit instead.
  */
 export const sendOsNotification: typeof Base.sendOsNotification = (payload) =>
   presentHarmonyNotification(payload);
