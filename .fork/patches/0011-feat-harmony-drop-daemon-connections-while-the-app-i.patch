   }
 });
 
+test("suspend keeps the connection down until resume, then reconnects at once", async () => {
+  useHeartbeatClock();
+  try {
+    const first = createMockTransport();
+    const second = createMockTransport();
+    const transports = [first, second];
+    let transportIndex = 0;
+    const client = new DaemonClient({
+      url: "ws://test",
+      clientId: "clsk_suspend",
+      reconnect: { enabled: true, baseDelayMs: 1_500, maxDelayMs: 1_500 },
+      transportFactory: () => {
+        const transport = transports[transportIndex];
+        if (!transport) throw new Error("unexpected extra reconnect");
+        transportIndex += 1;
+        return transport.transport;
+      },
+    });
+    clients.push(client);
+
+    const initialConnect = client.connect();
+    first.triggerOpen();
+    await initialConnect;
+    const close = vi.spyOn(first.transport, "close");
+
+    client.suspend("App in background");
+    expect(close).toHaveBeenCalledWith(1000, "App in background");
+    expect(client.getConnectionState().status).toBe("disconnected");
+
+    client.ensureConnected({ verify: true });
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(transportIndex).toBe(1);
+
+    client.resume();
+    expect(client.getConnectionState().status).toBe("connecting");
+    expect(transportIndex).toBe(2);
+    second.triggerOpen();
+    expect(client.getConnectionState().status).toBe("connected");
+  } finally {
+    vi.useRealTimers();
+  }
+});
+
 test("connect during a scheduled retry reconnects immediately without leaving the retry armed", async () => {
   useHeartbeatClock();
   try {
diff --git a/packages/client/src/daemon-client.ts b/packages/client/src/daemon-client.ts
index e637936b4..56fb90523 100644
--- a/packages/client/src/daemon-client.ts
+++ b/packages/client/src/daemon-client.ts
@@ -1328,6 +1328,8 @@ export class DaemonClient {
   private reconnectAttempt = 0;
   private traceConnectionAttempt = 0;
   private shouldReconnect = true;
+  // Set by suspend(): the connection stays down, whatever asks for it, until resume().
+  private suspended = false;
   private connectPromise: Promise<void> | null = null;
   private connectResolve: (() => void) | null = null;
   private connectReject: ((error: Error) => void) | null = null;
@@ -1675,7 +1677,7 @@ export class DaemonClient {
   }
 
   ensureConnected(options?: { verify?: boolean }): void {
-    if (this.connectionState.status === "disposed") {
+    if (this.connectionState.status === "disposed" || this.suspended) {
       return;
     }
     if (!this.shouldReconnect) {
@@ -1695,6 +1697,34 @@ export class DaemonClient {
     );
   }
 
+  /**
+   * Drops the connection but keeps the client, its subscriptions and its state, and keeps it
+   * down until resume(). For an app the platform freezes in the background: the daemon sees the
+   * device leave at once and pushes, instead of handing an in-app alert to a socket nobody
+   * answers until its lease runs out.
+   */
+  suspend(reason = "Suspended"): void {
+    if (this.connectionState.status === "disposed" || this.suspended) {
+      return;
+    }
+    this.suspended = true;
+    this.setReconnectEnabled(false);
+    if (this.transport || this.connectionState.status === "connecting") {
+      this.disposeTransport(1000, reason);
+      this.scheduleReconnect({ reason, event: "SUSPENDED", reasonCode: "suspended" });
+    }
+  }
+
+  /** Ends suspend() and reconnects at once, skipping any reconnect backoff. */
+  resume(): void {
+    if (!this.suspended) {
+      return;
+    }
+    this.suspended = false;
+    this.setReconnectEnabled(true);
+    this.ensureConnected();
+  }
+
   private verifyConnection(): void {
     const transport = this.transport;
     if (!transport || this.connectionVerification === transport) return;
