+import { ExpoPushProvider, EXPO_PROVIDER_ID } from "./providers/expo/provider.js";
+import type { PushProviderManifestEntry } from "./push-provider.js";
+
+/**
+ * Every push channel the daemon knows about.
+ *
+ * Adding one is a new directory under providers/ plus one entry here. Nothing
+ * else in the push module should need to know a provider exists.
+ */
+export const PUSH_PROVIDERS: readonly PushProviderManifestEntry[] = [
+  {
+    providerId: EXPO_PROVIDER_ID,
+    // Always available: Expo needs no daemon-side credentials.
+    create: (options) => new ExpoPushProvider(options),
+  },
+];
diff --git a/packages/server/src/server/push/providers/expo/provider.ts b/packages/server/src/server/push/providers/expo/provider.ts
new file mode 100644
index 000000000..bd4d1b21c
--- /dev/null
+++ b/packages/server/src/server/push/providers/expo/provider.ts
@@ -0,0 +1,134 @@
+import type pino from "pino";
+
+import type {
+  PushDeliveryResult,
+  PushPayload,
+  PushProvider,
+  PushProviderFactoryOptions,
+} from "../../push-provider.js";
+
+interface ExpoPushMessage {
+  to: string;
+  title: string;
+  body: string;
+  data?: Record<string, unknown>;
+  sound?: "default";
+}
+
+interface ExpoPushTicket {
+  status: "ok" | "error";
+  id?: string;
+  message?: string;
+  details?: { error?: string };
+}
+
+const DEFAULT_EXPO_PUSH_URL = "https://exp.host/--/api/v2/push/send";
+const MAX_BATCH_SIZE = 100;
+
+export const EXPO_PROVIDER_ID = "expo";
+
+interface ExpoProviderConfig {
+  /** Overridable so a test or a proxy deployment does not have to patch fetch. */
+  baseUrl?: string;
+}
+
+function readConfig(config: unknown): ExpoProviderConfig {
+  if (!config || typeof config !== "object") return {};
+  const candidate = config as { baseUrl?: unknown };
+  return typeof candidate.baseUrl === "string" && candidate.baseUrl.length > 0
+    ? { baseUrl: candidate.baseUrl }
+    : {};
+}
+
+/**
+ * Expo push delivery.
+ *
+ * Behaviour is unchanged from the previous PushService: same endpoint, same
+ * batch size, same ticket handling. The only difference is that dead tokens are
+ * returned instead of revoked through a callback, so the store decides when a
+ * revocation is durable.
+ */
+export class ExpoPushProvider implements PushProvider {
+  readonly providerId = EXPO_PROVIDER_ID;
+
+  private readonly logger: pino.Logger;
+  private readonly baseUrl: string;
+  private readonly fetchImpl: typeof fetch;
+
+  constructor(options: PushProviderFactoryOptions) {
+    this.logger = options.logger.child({ component: "push-provider", provider: EXPO_PROVIDER_ID });
+    this.baseUrl = readConfig(options.config).baseUrl ?? DEFAULT_EXPO_PUSH_URL;
+    this.fetchImpl = options.fetch ?? fetch;
+  }
+
+  async deliver(tokens: readonly string[], payload: PushPayload): Promise<PushDeliveryResult> {
+    if (tokens.length === 0) {
+      return {};
+    }
+
+    const messages: ExpoPushMessage[] = tokens.map((token) => ({
+      to: token,
+      title: payload.title,
+      body: payload.body,
+      data: payload.data,
+      sound: "default",
+    }));
+
+    const batches: ExpoPushMessage[][] = [];
+    for (let i = 0; i < messages.length; i += MAX_BATCH_SIZE) {
+      batches.push(messages.slice(i, i + MAX_BATCH_SIZE));
+    }
+
+    const revoked = await Promise.all(batches.map((batch) => this.sendBatch(batch)));
+    return { revokedTokens: revoked.flat() };
+  }
+
+  private async sendBatch(messages: ExpoPushMessage[]): Promise<string[]> {
+    try {
+      const response = await this.fetchImpl(this.baseUrl, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          Accept: "application/json",
+        },
+        body: JSON.stringify(messages),
+      });
+
+      if (!response.ok) {
+        this.logger.error(
+          { status: response.status, statusText: response.statusText },
+          "Expo push API error",
+        );
+        return [];
+      }
+
+      const result = (await response.json()) as { data: ExpoPushTicket[] };
+      return this.collectRevoked(messages, result.data);
+    } catch (error) {
+      this.logger.error({ err: error }, "Failed to send push notifications");
+      return [];
+    }
+  }
+
+  private collectRevoked(messages: ExpoPushMessage[], tickets: ExpoPushTicket[]): string[] {
+    const revoked: string[] = [];
+    for (let i = 0; i < tickets.length; i++) {
+      const ticket = tickets[i];
+      const message = messages[i];
+      if (!ticket || !message || ticket.status !== "error") continue;
+
+      this.logger.error(
+        { token: message.to, message: ticket.message, details: ticket.details },
+        "Push failed for token",
+      );
+
+      if (
+        ticket.details?.error === "DeviceNotRegistered" ||
+        ticket.details?.error === "InvalidCredentials"
+      ) {
+        revoked.push(message.to);
+      }
+    }
+    return revoked;
+  }
+}
diff --git a/packages/server/src/server/push/push-provider.ts b/packages/server/src/server/push/push-provider.ts
new file mode 100644
index 000000000..8b96ef837
--- /dev/null
+++ b/packages/server/src/server/push/push-provider.ts
@@ -0,0 +1,61 @@
+import type pino from "pino";
+
+export interface PushPayload {
+  title: string;
+  body: string;
+  data?: Record<string, unknown>;
+}
+
+/**
+ * A delivery channel for push notifications.
+ *
+ * Providers are stateless with respect to the token store: they are handed the
+ * tokens to deliver to and report back which ones the upstream service says are
+ * permanently gone. They never mutate the store themselves — see
+ * {@link PushDeliveryResult.revokedTokens} for why.
+ */
+export interface PushProvider {
+  /** Wire value, config key and manifest key. One name, no synonyms. */
+  readonly providerId: string;
+
+  /**
+   * Delivers to every token.
+   *
+   * Must not throw: one provider failing has to leave the others unaffected.
+   * Transport errors are the provider's own to log and swallow.
+   */
+  deliver(tokens: readonly string[], payload: PushPayload): Promise<PushDeliveryResult>;
+}
+
+export interface PushDeliveryResult {
+  /**
+   * Tokens the upstream service reports as permanently dead.
+   *
+   * Returned rather than revoked directly because the store only considers a
+   * revocation real once it is durable — `persist` throws on a write failure and
+   * the caller keeps the previous state. A provider holding a revoke callback
+   * cannot honour that, and would drop tokens that are still live on disk.
+   *
+   * Only permanent failures belong here. A timeout or a 500 is not one.
+   */
+  readonly revokedTokens?: readonly string[];
+}
+
+export interface PushProviderFactoryOptions {
+  readonly logger: pino.Logger;
+  /** The provider's own slice of persisted config; each provider validates its own. */
+  readonly config: unknown;
+  /** Injectable for tests; defaults to the global fetch. */
+  readonly fetch?: typeof fetch;
+}
+
+export interface PushProviderManifestEntry {
+  readonly providerId: string;
+  /**
+   * Builds the provider, or returns null when the daemon holds no credentials
+   * for it. A null provider is not an error: it means this host cannot deliver
+   * through that channel, which is what the client is told so it never
+   * registers a token nobody can route.
+   */
+  create(options: PushProviderFactoryOptions): PushProvider | null;
+}
