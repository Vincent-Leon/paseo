+import { assertCoversExports } from "@/harmony/variant";
+import { harmonyHost } from "@/harmony/host";
+import type * as Base from "./keep-awake";
+
+// The window stays on while any tag holds it, the way expo-keep-awake counts tags.
+const tags = new Set<string>();
+
+export const activateKeepAwakeAsync: typeof Base.activateKeepAwakeAsync = async (
+  tag = "default",
+) => {
+  tags.add(tag);
+  await harmonyHost.request("screen.keepOn", { on: true });
+};
+
+export const deactivateKeepAwake: typeof Base.deactivateKeepAwake = async (tag = "default") => {
+  tags.delete(tag);
+  if (tags.size > 0) return;
+  await harmonyHost.request("screen.keepOn", { on: false });
+};
+
+assertCoversExports<typeof Base, typeof import("./keep-awake.harmony")>();
