index 000000000..97a146a6a
--- /dev/null
+++ b/packages/app/src/harmony/visibility.ts
@@ -0,0 +1,63 @@
+/**
+ * Makes the page's visibility follow the HarmonyOS app lifecycle.
+ *
+ * The app reads presence from the document: react-native-web's AppState listens for
+ * `visibilitychange`, and through it the client activity tracker and the alert decision know
+ * whether Paseo is in front. A web view inside a backgrounded app does not reliably go hidden,
+ * so without this the daemon would see the phone as present while it sits in a pocket, keep its
+ * alerts in-app, and nothing would ever reach the notification shade.
+ *
+ * Until the shell reports a state, the web view's own visibility stands.
+ */
+
+type VisibilityState = "visible" | "hidden";
+
+interface VisibilityDocument extends EventTarget {
+  visibilityState: DocumentVisibilityState;
+  hidden: boolean;
+}
+
+export interface HostVisibility {
+  setHostState(state: "active" | "background"): void;
+}
+
+function readOwnGetter<T>(doc: object, property: string): (() => T) | null {
+  let prototype: object | null = Object.getPrototypeOf(doc);
+  while (prototype) {
+    const descriptor = Object.getOwnPropertyDescriptor(prototype, property);
+    if (descriptor?.get) {
+      const getter = descriptor.get;
+      return () => getter.call(doc) as T;
+    }
+    prototype = Object.getPrototypeOf(prototype);
+  }
+  return null;
+}
+
+export function installHostVisibility(doc: VisibilityDocument): HostVisibility {
+  const nativeState = readOwnGetter<DocumentVisibilityState>(doc, "visibilityState");
+  let hostState: VisibilityState | null = null;
+
+  const current = (): VisibilityState => {
+    if (hostState !== null) return hostState;
+    return nativeState?.() === "hidden" ? "hidden" : "visible";
+  };
+
+  Object.defineProperty(doc, "visibilityState", {
+    configurable: true,
+    get: current,
+  });
+  Object.defineProperty(doc, "hidden", {
+    configurable: true,
+    get: () => current() === "hidden",
+  });
+
+  return {
+    setHostState(state) {
+      const next: VisibilityState = state === "active" ? "visible" : "hidden";
+      const before = current();
+      hostState = next;
+      if (before !== next) doc.dispatchEvent(new Event("visibilitychange"));
+    },
+  };
+}
