+import { assertCoversExports } from "@/harmony/variant";
+import { harmonyHost } from "@/harmony/host";
+import type * as Base from "./system-qr-scanner";
+
+export type SystemQrScanner = Base.SystemQrScanner;
+
+const scanWithShell: SystemQrScanner = async () => {
+  const result = await harmonyHost.request<{ value: string | null }>("scan.qr", undefined, {
+    // The scanner stays up for as long as the person keeps it up.
+    timeoutMs: null,
+  });
+  return result.value;
+};
+
+/** Scan Kit, through the shell. Some 2in1 devices have none, and the shell says so. */
+export const getSystemQrScanner: typeof Base.getSystemQrScanner = () =>
+  harmonyHost.hostInfo()?.canScan === true ? scanWithShell : null;
+
+export const canScanPairingQr: typeof Base.canScanPairingQr = () => getSystemQrScanner() !== null;
+
+assertCoversExports<typeof Base, typeof import("./system-qr-scanner.harmony")>();
