+/** Resolves the scanned text, or null when the person backs out. */
+export type SystemQrScanner = () => Promise<string | null>;
+
+/**
+ * A scanner the platform shows on its own, outside the app's camera view. Only the HarmonyOS
+ * shell has one (system-qr-scanner.harmony.ts); native builds scan with expo-camera instead.
+ */
+export function getSystemQrScanner(): SystemQrScanner | null {
+  return null;
+}
+
+/** Whether this build can pair a host by scanning its QR code. */
+export function canScanPairingQr(): boolean {
+  return (isNative && !isFdroidBuild) || getSystemQrScanner() !== null;
+}
