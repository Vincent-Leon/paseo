+/**
+ * Fails the typecheck when a `*.harmony.ts` variant lacks an export of the module it replaces.
+ *
+ * Metro swaps the whole file, and TypeScript only ever sees the base, so a missing export would
+ * otherwise surface as `undefined` at runtime in the HarmonyOS build alone. Call it with the base
+ * module's type and the variant's own:
+ *
+ *   assertCoversExports<typeof Base, typeof import("./thing.harmony")>();
+ */
+export function assertCoversExports<Base, _Variant extends { [K in keyof Base]: unknown }>(): void {}
