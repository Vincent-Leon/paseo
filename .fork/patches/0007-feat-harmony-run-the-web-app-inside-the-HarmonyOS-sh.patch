diff --git a/packages/app/src/appearance/system-bars.harmony.tsx b/packages/app/src/appearance/system-bars.harmony.tsx
new file mode 100644
index 000000000..f2693bf5b
--- /dev/null
+++ b/packages/app/src/appearance/system-bars.harmony.tsx
@@ -0,0 +1,39 @@
+import { assertCoversExports } from "@/harmony/variant";
+import { useEffect } from "react";
+import { withUnistyles } from "react-native-unistyles";
+import { harmonyHost } from "@/harmony/host";
+import type { Theme } from "@/styles/theme";
+import type * as Base from "./system-bars";
+
+// HarmonyOS takes #RRGGBB only (its own alpha form is #AARRGGBB, the reverse of CSS).
+function opaqueHex(color: string): string | undefined {
+  const value = color.trim();
+  if (/^#[0-9a-fA-F]{6}$/.test(value)) return value;
+  const short = /^#([0-9a-fA-F])([0-9a-fA-F])([0-9a-fA-F])$/.exec(value);
+  if (short) return `#${short[1]}${short[1]}${short[2]}${short[2]}${short[3]}${short[3]}`;
+  return undefined;
+}
+
+function ThemeSystemBars({
+  colorScheme,
+  background,
+}: {
+  colorScheme: Theme["colorScheme"];
+  background: string;
+}) {
+  // The shell paints the status bar and the navigation area to match the page.
+  useEffect(() => {
+    harmonyHost.send("systemBars.set", {
+      dark: colorScheme !== "light",
+      background: opaqueHex(background),
+    });
+  }, [background, colorScheme]);
+  return null;
+}
+
+export const AppearanceSystemBars = withUnistyles(ThemeSystemBars, (theme) => ({
+  colorScheme: theme.colorScheme,
+  background: theme.colors.surface0,
+}));
+
+assertCoversExports<typeof Base, typeof import("./system-bars.harmony")>();
