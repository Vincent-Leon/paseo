+import { assertCoversExports } from "@/harmony/variant";
+import {
+  presentHarmonyNotification,
+  requestHarmonyNotificationPermission,
+} from "@/harmony/notifications";
+import type * as Base from "./os-notifications";
+
+export type WebNotificationClickDetail = Base.WebNotificationClickDetail;
+
+// Raised by browser notification clicks; HarmonyHostSync raises it for the shell's taps.
+export const WEB_NOTIFICATION_CLICK_EVENT = "paseo:web-notification-click";
+
+export const ensureOsNotificationPermission: typeof Base.ensureOsNotificationPermission = () =>
+  requestHarmonyNotificationPermission();
+
+/**
+ * HarmonyOS has no push for Paseo, so every alert the page decides to show is a local
+ * notification from the shell. In the background that only happens while the continuous task
+ * keeps the page alive; without it the system freezes the page and nothing runs at all.
+ */
+export const sendOsNotification: typeof Base.sendOsNotification = (payload) =>
+  presentHarmonyNotification(payload);
+
+assertCoversExports<typeof Base, typeof import("./os-notifications.harmony")>();
