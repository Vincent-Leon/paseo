+import { describe, expect, it } from "vitest";
+import { addHarmonyBackHandler, runHarmonyBackHandlers } from "./back";
+import { isUrgentNotification, notificationKey, parseNotificationTapData } from "./notifications";
+
+describe("HarmonyOS notifications", () => {
+  it("keys an alert by its agent or terminal, so a newer one replaces the older", () => {
+    const finished = {
+      title: "Fix tests",
+      data: { serverId: "srv", agentId: "a1", reason: "finished" },
+    };
+    const permission = {
+      title: "Fix tests",
+      data: { serverId: "srv", agentId: "a1", reason: "permission" },
+    };
+    const terminal = { title: "npm test", data: { serverId: "srv", terminalId: "t1" } };
+
+    expect(notificationKey(finished)).toBe(notificationKey(permission));
+    expect(notificationKey(terminal)).toBe("srv:t1");
+    expect(notificationKey({ title: "Paseo" })).toBe(":Paseo");
+  });
+
+  it("rings only for a permission request", () => {
+    expect(isUrgentNotification({ title: "x", data: { reason: "permission" } })).toBe(true);
+    expect(isUrgentNotification({ title: "x", data: { reason: "finished" } })).toBe(false);
+    expect(isUrgentNotification({ title: "x" })).toBe(false);
+  });
+
+  it("reads back the data a tap carries, and nothing else", () => {
+    const data = { serverId: "srv", agentId: "a1", reason: "finished" };
+
+    expect(parseNotificationTapData({ data: JSON.stringify(data) })).toEqual(data);
+    expect(parseNotificationTapData({ data: "[1]" })).toBeUndefined();
+    expect(parseNotificationTapData({ data: "{" })).toBeUndefined();
+    expect(parseNotificationTapData(null)).toBeUndefined();
+  });
+});
+
+describe("HarmonyOS back gesture", () => {
+  it("asks the newest handler first and stops at the first that consumes the press", () => {
+    const calls: string[] = [];
+    const stopOuter = addHarmonyBackHandler(() => {
+      calls.push("outer");
+      return true;
+    });
+    const stopInner = addHarmonyBackHandler(() => {
+      calls.push("inner");
+      return false;
+    });
+
+    expect(runHarmonyBackHandlers()).toBe(true);
+    expect(calls).toEqual(["inner", "outer"]);
+
+    stopOuter();
+    stopInner();
+    expect(runHarmonyBackHandlers()).toBe(false);
+  });
+});
