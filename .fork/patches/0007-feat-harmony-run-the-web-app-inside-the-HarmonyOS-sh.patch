@@ -0,0 +1,72 @@
+import { harmonyHost } from "./host";
+
+export interface HarmonyNotification {
+  title: string;
+  body?: string;
+  data?: Record<string, unknown>;
+}
+
+function stringField(data: Record<string, unknown> | undefined, key: string): string | null {
+  const value = data?.[key];
+  return typeof value === "string" && value.length > 0 ? value : null;
+}
+
+/**
+ * One notification per agent or terminal: a newer alert replaces the older one instead of
+ * stacking, the way a push for the same agent collapses on Android.
+ */
+export function notificationKey(notification: HarmonyNotification): string {
+  const serverId = stringField(notification.data, "serverId") ?? "";
+  const subject =
+    stringField(notification.data, "agentId") ??
+    stringField(notification.data, "terminalId") ??
+    notification.title;
+  return `${serverId}:${subject}`;
+}
+
+/** A permission request blocks an agent until someone answers, so it rings. */
+export function isUrgentNotification(notification: HarmonyNotification): boolean {
+  return stringField(notification.data, "reason") === "permission";
+}
+
+export async function presentHarmonyNotification(
+  notification: HarmonyNotification,
+): Promise<boolean> {
+  try {
+    const result = await harmonyHost.request<{ presented: boolean }>("notifications.present", {
+      key: notificationKey(notification),
+      title: notification.title,
+      body: notification.body ?? "",
+      // Handed back untouched on a tap, and routed like a browser notification click.
+      data: JSON.stringify(notification.data ?? {}),
+      urgent: isUrgentNotification(notification),
+    });
+    return result.presented;
+  } catch (error) {
+    console.warn("[HarmonyNotifications] Failed to present", error);
+    return false;
+  }
+}
+
+export async function requestHarmonyNotificationPermission(): Promise<boolean> {
+  try {
+    const result = await harmonyHost.request<{ enabled: boolean }>("notifications.request");
+    return result.enabled;
+  } catch {
+    return false;
+  }
+}
+
+/** Notification taps carry back the JSON this page handed over. */
+export function parseNotificationTapData(payload: unknown): Record<string, unknown> | undefined {
+  const raw = (payload as { data?: unknown } | null)?.data;
+  if (typeof raw !== "string") return undefined;
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+      ? (parsed as Record<string, unknown>)
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
