index 000000000..caf33a819
--- /dev/null
+++ b/packages/app/src/harmony/host.ts
@@ -0,0 +1,237 @@
+/**
+ * The page side of the HarmonyOS shell bridge.
+ *
+ * The HarmonyOS app is an ArkWeb shell around this web build (repo paseo-harmony,
+ * entry/src/main/ets/shell/Bridge.ets). The shell injects `window.paseoHarmony` and answers
+ * by calling `window.__paseoHarmonyReceive`; the message shapes here and there have to agree.
+ *
+ * Only `*.harmony.ts` modules import this. A build with PASEO_WEB_PLATFORM=harmony resolves
+ * them; every other platform never loads it.
+ */
+
+export interface HarmonyBridgeObject {
+  post(message: string): void;
+  hostInfo(): string;
+}
+
+export interface HarmonyHostInfo {
+  shell: "harmony";
+  shellVersion: string;
+  shellVersionCode: number;
+  debug: boolean;
+  deviceType: string;
+  osFullName: string;
+  apiVersion: number;
+  canScan: boolean;
+  bundleStamp: string;
+  foreground: boolean;
+  backgroundActive: boolean;
+  notificationsEnabled: boolean;
+}
+
+interface HostResponse {
+  kind: "response";
+  id: number;
+  ok: boolean;
+  result: unknown;
+  error: string | null;
+}
+
+interface HostEvent {
+  kind: "event";
+  type: string;
+  payload: unknown;
+}
+
+type HostMessage = HostResponse | HostEvent;
+
+export interface HarmonyRequestOptions {
+  /** `null` waits indefinitely, for requests that wait on a person (scanning, pickers). */
+  timeoutMs?: number | null;
+}
+
+export interface HarmonyChannelEnvironment {
+  bridge: () => HarmonyBridgeObject | null;
+  installReceiver: (receive: (message: string) => void) => void;
+  setTimer: (callback: () => void, ms: number) => unknown;
+  clearTimer: (handle: unknown) => void;
+}
+
+type EventListener = (payload: unknown) => void;
+
+interface PendingRequest {
+  resolve: (value: unknown) => void;
+  reject: (error: Error) => void;
+  timer: unknown;
+}
+
+const DEFAULT_TIMEOUT_MS = 30_000;
+// Events nobody listens to yet are held, because a notification tap that cold-starts the app
+// arrives before the screen that routes it has mounted.
+const MAX_BUFFERED_EVENTS = 32;
+
+function isHostMessage(value: unknown): value is HostMessage {
+  if (typeof value !== "object" || value === null) return false;
+  const kind = (value as { kind?: unknown }).kind;
+  return kind === "response" || kind === "event";
+}
+
+export class HarmonyChannel {
+  private readonly env: HarmonyChannelEnvironment;
+  private nextId = 1;
+  private connected = false;
+  private readonly pending = new Map<number, PendingRequest>();
+  private readonly listeners = new Map<string, Set<EventListener>>();
+  private buffered: HostEvent[] = [];
+
+  constructor(env: HarmonyChannelEnvironment) {
+    this.env = env;
+  }
+
+  isAvailable(): boolean {
+    return this.env.bridge() !== null;
+  }
+
+  /** Installs the receiver and tells the shell the page can take events. Idempotent. */
+  connect(): boolean {
+    const bridge = this.env.bridge();
+    if (!bridge) return false;
+    if (this.connected) return true;
+    this.connected = true;
+    this.env.installReceiver((message) => this.receive(message));
+    bridge.post(JSON.stringify({ id: 0, type: "ready" }));
+    return true;
+  }
+
+  hostInfo(): HarmonyHostInfo | null {
+    const bridge = this.env.bridge();
+    if (!bridge) return null;
+    try {
+      return JSON.parse(bridge.hostInfo()) as HarmonyHostInfo;
+    } catch {
+      return null;
+    }
+  }
+
+  request<T>(type: string, payload?: unknown, options: HarmonyRequestOptions = {}): Promise<T> {
+    const bridge = this.env.bridge();
+    if (!bridge) {
+      return Promise.reject(new Error("The HarmonyOS shell is not available"));
+    }
+    // Answers come back through the receiver, so it has to be in place before anything is asked.
+    this.connect();
+    const id = this.nextId++;
+    const timeoutMs = options.timeoutMs === undefined ? DEFAULT_TIMEOUT_MS : options.timeoutMs;
+    return new Promise<T>((resolve, reject) => {
+      const timer =
+        timeoutMs === null
+          ? null
+          : this.env.setTimer(() => {
+              this.pending.delete(id);
+              reject(new Error(`HarmonyOS shell did not answer ${type}`));
+            }, timeoutMs);
+      this.pending.set(id, {
+        resolve: (value) => resolve(value as T),
+        reject,
+        timer,
+      });
+      try {
+        bridge.post(JSON.stringify({ id, type, payload }));
+      } catch (error) {
+        this.settle(id);
+        reject(error instanceof Error ? error : new Error(String(error)));
+      }
+    });
+  }
+
+  /** A request nobody waits on. */
+  send(type: string, payload?: unknown): void {
+    const bridge = this.env.bridge();
+    if (!bridge) return;
+    this.connect();
+    try {
+      bridge.post(JSON.stringify({ id: 0, type, payload }));
+    } catch {
+      // The shell is gone; there is nobody to tell.
+    }
+  }
+
+  on(type: string, listener: EventListener): () => void {
+    // The shell holds its events until the page says it is ready, and a listener is the first
+    // sign that it is.
+    this.connect();
+    let set = this.listeners.get(type);
+    if (!set) {
+      set = new Set();
+      this.listeners.set(type, set);
+    }
+    set.add(listener);
+
+    const replay = this.buffered.filter((event) => event.type === type);
+    if (replay.length > 0) {
+      this.buffered = this.buffered.filter((event) => event.type !== type);
+      for (const event of replay) listener(event.payload);
+    }
+
+    return () => {
+      set?.delete(listener);
+    };
+  }
+
+  receive(message: string): void {
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(message);
+    } catch {
+      return;
+    }
+    if (!isHostMessage(parsed)) return;
+
+    if (parsed.kind === "response") {
+      const pending = this.settle(parsed.id);
+      if (!pending) return;
+      if (parsed.ok) {
+        pending.resolve(parsed.result);
+      } else {
+        pending.reject(new Error(parsed.error ?? "HarmonyOS shell request failed"));
+      }
+      return;
+    }
+
+    const listeners = this.listeners.get(parsed.type);
+    if (!listeners || listeners.size === 0) {
+      this.buffered.push(parsed);
+      if (this.buffered.length > MAX_BUFFERED_EVENTS) this.buffered.shift();
+      return;
+    }
+    // A copy, so a listener that unsubscribes while it runs does not skip the next one.
+    for (const listener of Array.from(listeners)) listener(parsed.payload);
+  }
+
+  private settle(id: number): PendingRequest | undefined {
+    const pending = this.pending.get(id);
+    if (!pending) return undefined;
+    this.pending.delete(id);
+    if (pending.timer !== null) this.env.clearTimer(pending.timer);
+    return pending;
+  }
+}
+
+interface HarmonyGlobal {
+  paseoHarmony?: HarmonyBridgeObject;
+  __paseoHarmonyReceive?: (message: string) => void;
+}
+
+function harmonyGlobal(): HarmonyGlobal | null {
+  return typeof window === "undefined" ? null : (window as unknown as HarmonyGlobal);
+}
+
+export const harmonyHost = new HarmonyChannel({
+  bridge: () => harmonyGlobal()?.paseoHarmony ?? null,
+  installReceiver: (receive) => {
+    const target = harmonyGlobal();
+    if (target) target.__paseoHarmonyReceive = receive;
+  },
+  setTimer: (callback, ms) => setTimeout(callback, ms),
+  clearTimer: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+});
