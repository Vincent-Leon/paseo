+import { assertCoversExports } from "@/harmony/variant";
+import { harmonyHost } from "@/harmony/host";
+import { isHttpUrl } from "./http-url";
+import type * as Base from "./open-external-url";
+
+/** The shell hands the link to the system, which opens the default browser. */
+export const openExternalUrl: typeof Base.openExternalUrl = async (url) => {
+  if (!isHttpUrl(url)) return;
+  try {
+    await harmonyHost.request("links.open", { url });
+  } catch (error) {
+    console.warn("[HarmonyLinks] Failed to open", error);
+  }
+};
+
+assertCoversExports<typeof Base, typeof import("./open-external-url.harmony")>();
