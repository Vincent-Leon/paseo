diff --git a/packages/app/src/harmony/back.ts b/packages/app/src/harmony/back.ts
new file mode 100644
index 000000000..ce0f5dc02
--- /dev/null
+++ b/packages/app/src/harmony/back.ts
@@ -0,0 +1,24 @@
+/**
+ * The HarmonyOS back gesture, for code that handles Android's hardware Back.
+ *
+ * Handlers run newest first, like React Native's BackHandler, and the first one to return true
+ * consumes the press.
+ */
+type BackHandler = () => boolean;
+
+const handlers: BackHandler[] = [];
+
+export function addHarmonyBackHandler(handler: BackHandler): () => void {
+  handlers.push(handler);
+  return () => {
+    const index = handlers.lastIndexOf(handler);
+    if (index !== -1) handlers.splice(index, 1);
+  };
+}
+
+export function runHarmonyBackHandlers(): boolean {
+  for (let index = handlers.length - 1; index >= 0; index -= 1) {
+    if (handlers[index]?.()) return true;
+  }
+  return false;
+}
diff --git a/packages/app/src/harmony/host-sync.harmony.tsx b/packages/app/src/harmony/host-sync.harmony.tsx
new file mode 100644
index 000000000..cbea1e720
--- /dev/null
+++ b/packages/app/src/harmony/host-sync.harmony.tsx
@@ -0,0 +1,159 @@
+import { assertCoversExports } from "./variant";
+import { useEffect } from "react";
+import { useRouter } from "expo-router";
+import { parseAgentDeepLink } from "@getpaseo/protocol/agent-deep-link";
+import { dispatchTopWebOverlayKeyDown } from "@/lib/overlay-root";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import { buildOpenProjectRoute } from "@/utils/host-routes";
+import { navigateToAgent } from "@/utils/navigate-to-agent";
+import { runHarmonyBackHandlers } from "./back";
+import { harmonyHost } from "./host";
+import { parseNotificationTapData, requestHarmonyNotificationPermission } from "./notifications";
+import { installHostVisibility } from "./visibility";
+import type * as Base from "./host-sync";
+
+const NOTIFICATIONS_ASKED_KEY = "@paseo:harmony-notifications-asked";
+// The event a browser notification click raises (os-notifications.ts); the app's notification
+// router handles it and calls preventDefault.
+const WEB_NOTIFICATION_CLICK_EVENT = "paseo:web-notification-click";
+const TAP_RETRY_MS = 500;
+const TAP_GIVE_UP_MS = 15_000;
+
+function field(payload: unknown, key: string): unknown {
+  return typeof payload === "object" && payload !== null
+    ? (payload as Record<string, unknown>)[key]
+    : undefined;
+}
+
+// Module scope, so the page follows the app's lifecycle from the first event on, before React
+// has rendered anything that reads it.
+const visibility = typeof document === "undefined" ? null : installHostVisibility(document);
+if (harmonyHost.hostInfo()?.foreground === false) visibility?.setHostState("background");
+
+harmonyHost.on("lifecycle", (payload) => {
+  const state = field(payload, "state");
+  if (state !== "active" && state !== "background") return;
+  visibility?.setHostState(state);
+  if (state === "active") reportBackgroundDiagnostics();
+});
+
+/**
+ * Pings every live connection and reconnects a dead one at once, skipping the backoff timer.
+ * A hidden page's own timers can be throttled to once a minute, slower than the relay's idle
+ * lease, so while the continuous task holds the app the shell drives this instead.
+ */
+function keepConnectionsAlive(): void {
+  getHostRuntimeStore().ensureConnectedAll({ verify: true });
+}
+
+harmonyHost.on("tick", (payload) => {
+  harmonyHost.send("tick.ack", { sentAt: field(payload, "sentAt") });
+  keepConnectionsAlive();
+});
+
+// A network switch kills sockets without a close event.
+harmonyHost.on("network", (payload) => {
+  if (field(payload, "available") === true) keepConnectionsAlive();
+});
+
+/** Whether the page kept running in the background shows up in the device log on every return. */
+function reportBackgroundDiagnostics(): void {
+  void harmonyHost
+    .request("diagnostics")
+    .then((diagnostics) =>
+      harmonyHost.send("log", { level: "info", message: `resumed ${JSON.stringify(diagnostics)}` }),
+    )
+    .catch(() => undefined);
+}
+
+/**
+ * Hands a notification tap to the app's notification router as a browser notification click.
+ * A tap that cold-starts the app can arrive before the router has mounted; nobody cancelling the
+ * event means nobody handled it, so it is offered again until someone does.
+ */
+function openNotificationTap(data: Record<string, unknown> | undefined, startedAt = Date.now()) {
+  const event = new CustomEvent(WEB_NOTIFICATION_CLICK_EVENT, {
+    detail: { data },
+    cancelable: true,
+  });
+  const unhandled = window.dispatchEvent(event);
+  if (unhandled && Date.now() - startedAt < TAP_GIVE_UP_MS) {
+    setTimeout(() => openNotificationTap(data, startedAt), TAP_RETRY_MS);
+  }
+}
+
+harmonyHost.on("notification.open", (payload) => {
+  openNotificationTap(parseNotificationTapData(payload));
+});
+
+function isPairingLink(url: string): boolean {
+  return url.includes("#offer=") || url.includes("#connect=") || url.startsWith("relay://");
+}
+
+/**
+ * Back closes what is on top first, the way Escape does in a browser, then whatever Android's
+ * hardware Back would close, then goes back in history. Only when nothing is left does the shell
+ * send the app to the background.
+ */
+function handleBack(router: ReturnType<typeof useRouter>): boolean {
+  const escape = new KeyboardEvent("keydown", { key: "Escape", bubbles: true, cancelable: true });
+  if (dispatchTopWebOverlayKeyDown(escape)) return true;
+  if (runHarmonyBackHandlers()) return true;
+  if (router.canGoBack()) {
+    router.back();
+    return true;
+  }
+  return false;
+}
+
+/** The HarmonyOS shell's page-side wiring: back gesture, links from outside, first-run asks. */
+export function HarmonyHostSync() {
+  const router = useRouter();
+
+  useEffect(() => {
+    const stopBack = harmonyHost.on("back", (payload) => {
+      let handled = false;
+      try {
+        handled = handleBack(router);
+      } finally {
+        harmonyHost.send("back.result", { seq: field(payload, "seq"), handled });
+      }
+    });
+
+    const stopLinks = harmonyHost.on("link.open", (payload) => {
+      const url = field(payload, "url");
+      if (typeof url !== "string") return;
+      if (isPairingLink(url)) {
+        void getHostRuntimeStore()
+          .importConnectionLink(url, "openProject")
+          .then((result) => {
+            if (result.status === "connected") router.replace(buildOpenProjectRoute());
+            return;
+          })
+          .catch((error) => console.warn("[HarmonyHost] Pairing link failed", error));
+        return;
+      }
+      const agent = parseAgentDeepLink(url);
+      if (agent) navigateToAgent({ ...agent, pin: true });
+    });
+
+    return () => {
+      stopBack();
+      stopLinks();
+    };
+  }, [router]);
+
+  // Without push, alerts only ever reach the shade as the shell's local notifications, so the
+  // permission is worth asking for up front, once.
+  useEffect(() => {
+    if (typeof localStorage === "undefined" || localStorage.getItem(NOTIFICATIONS_ASKED_KEY)) {
+      return;
+    }
+    localStorage.setItem(NOTIFICATIONS_ASKED_KEY, "1");
+    void requestHarmonyNotificationPermission();
+  }, []);
+
+  return null;
+}
+
+assertCoversExports<typeof Base, typeof import("./host-sync.harmony")>();
