new file mode 100644
index 000000000..159616c82
--- /dev/null
+++ b/packages/app/src/harmony/host.test.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from "vitest";
+import { HarmonyChannel, type HarmonyBridgeObject } from "./host";
+import { installHostVisibility } from "./visibility";
+
+interface Harness {
+  channel: HarmonyChannel;
+  posted: Array<{ id: number; type: string; payload?: unknown }>;
+  deliver: (message: unknown) => void;
+  fireTimers: () => void;
+}
+
+function createHarness(input: { bridge?: boolean } = {}): Harness {
+  const posted: Harness["posted"] = [];
+  const timers = new Map<number, () => void>();
+  let nextTimer = 1;
+  let receiver: ((message: string) => void) | null = null;
+  const bridge: HarmonyBridgeObject = {
+    post: (message) => posted.push(JSON.parse(message)),
+    hostInfo: () => JSON.stringify({ shell: "harmony", canScan: true }),
+  };
+  const channel = new HarmonyChannel({
+    bridge: () => (input.bridge === false ? null : bridge),
+    installReceiver: (receive) => {
+      receiver = receive;
+    },
+    setTimer: (callback) => {
+      const id = nextTimer++;
+      timers.set(id, callback);
+      return id;
+    },
+    clearTimer: (handle) => {
+      timers.delete(handle as number);
+    },
+  });
+  return {
+    channel,
+    posted,
+    deliver: (message) => receiver?.(JSON.stringify(message)),
+    fireTimers: () => {
+      const pending = [...timers.values()];
+      timers.clear();
+      for (const callback of pending) callback();
+    },
+  };
+}
+
+describe("HarmonyChannel", () => {
+  it("announces the page once and reads the host info synchronously", () => {
+    const harness = createHarness();
+
+    expect(harness.channel.connect()).toBe(true);
+    expect(harness.channel.connect()).toBe(true);
+
+    expect(harness.posted).toEqual([{ id: 0, type: "ready" }]);
+    expect(harness.channel.hostInfo()).toEqual({ shell: "harmony", canScan: true });
+  });
+
+  it("does nothing outside the shell", async () => {
+    const harness = createHarness({ bridge: false });
+
+    expect(harness.channel.connect()).toBe(false);
+    expect(harness.channel.hostInfo()).toBeNull();
+    await expect(harness.channel.request("scan.qr")).rejects.toThrow("not available");
+  });
+
+  it("matches answers to their requests by id", async () => {
+    const harness = createHarness();
+    harness.channel.connect();
+
+    const first = harness.channel.request<{ enabled: boolean }>("notifications.status");
+    const second = harness.channel.request("links.open", { url: "https://paseo.sh" });
+    const [, firstRequest, secondRequest] = harness.posted;
+
+    harness.deliver({
+      kind: "response",
+      id: secondRequest.id,
+      ok: false,
+      result: null,
+      error: "no",
+    });
+    harness.deliver({
+      kind: "response",
+      id: firstRequest.id,
+      ok: true,
+      result: { enabled: true },
+      error: null,
+    });
+
+    await expect(first).resolves.toEqual({ enabled: true });
+    await expect(second).rejects.toThrow("no");
+    expect(secondRequest.payload).toEqual({ url: "https://paseo.sh" });
+  });
+
+  it("gives up on a request the shell never answers, unless told to wait", async () => {
+    const harness = createHarness();
+    harness.channel.connect();
+
+    const timed = harness.channel.request("background.status");
+    const patient = harness.channel.request("scan.qr", undefined, { timeoutMs: null });
+    harness.fireTimers();
+
+    await expect(timed).rejects.toThrow("did not answer background.status");
+    const scanRequest = harness.posted[2];
+    harness.deliver({
+      kind: "response",
+      id: scanRequest.id,
+      ok: true,
+      result: { value: "x" },
+      error: null,
+    });
+    await expect(patient).resolves.toEqual({ value: "x" });
+  });
+
+  it("holds events until someone listens, then replays them in order", () => {
+    const harness = createHarness();
+    harness.channel.connect();
+    harness.deliver({ kind: "event", type: "notification.open", payload: { data: "a" } });
+    harness.deliver({ kind: "event", type: "notification.open", payload: { data: "b" } });
+
+    const received: unknown[] = [];
+    const unsubscribe = harness.channel.on("notification.open", (payload) =>
+      received.push(payload),
+    );
+    harness.deliver({ kind: "event", type: "notification.open", payload: { data: "c" } });
+    unsubscribe();
+    harness.deliver({ kind: "event", type: "notification.open", payload: { data: "d" } });
+
+    expect(received).toEqual([{ data: "a" }, { data: "b" }, { data: "c" }]);
+  });
+
+  it("ignores messages that are not from the shell", () => {
+    const harness = createHarness();
+    harness.channel.connect();
+    const received: unknown[] = [];
+    harness.channel.on("back", (payload) => received.push(payload));
+
+    harness.channel.receive("not json");
+    harness.deliver({ type: "back" });
+
+    expect(received).toEqual([]);
+  });
+});
+
+class FakeDocument extends EventTarget {
+  nativeHidden = false;
+
+  get visibilityState(): DocumentVisibilityState {
+    return this.nativeHidden ? "hidden" : "visible";
+  }
+
+  get hidden(): boolean {
+    return this.nativeHidden;
+  }
+}
+
+describe("installHostVisibility", () => {
+  it("follows the web view until the shell reports, then the shell", () => {
+    const doc = new FakeDocument();
+    const visibility = installHostVisibility(doc);
+    const events: string[] = [];
+    doc.addEventListener("visibilitychange", () => events.push(doc.visibilityState));
+
+    doc.nativeHidden = true;
+    expect(doc.visibilityState).toBe("hidden");
+    doc.nativeHidden = false;
+
+    visibility.setHostState("background");
+    expect(doc.visibilityState).toBe("hidden");
+    expect(doc.hidden).toBe(true);
+
+    // The web view itself still claims to be visible; the shell wins.
+    visibility.setHostState("background");
+    visibility.setHostState("active");
+
+    expect(doc.hidden).toBe(false);
+    expect(events).toEqual(["hidden", "visible"]);
+  });
+});
diff --git a/packages/app/src/harmony/host.ts b/packages/app/src/harmony/host.ts
