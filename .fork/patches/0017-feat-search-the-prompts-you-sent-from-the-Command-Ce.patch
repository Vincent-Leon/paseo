@@ -0,0 +1,297 @@
+import { appendFile, mkdir, mkdtemp, realpath, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import type { StoredAgentRecord } from "./agent-storage.js";
+import {
+  claudePromptFromLine,
+  cleanPrompt,
+  codexPromptFromLine,
+  PromptSearchIndex,
+  promptSnippet,
+  readNewPrompts,
+} from "./prompt-search.js";
+import { claudeProjectDirSync } from "./providers/claude/project-dir.js";
+
+const logger = pino({ level: "silent" });
+
+function claudeUser(text: unknown, timestamp: string, extra: Record<string, unknown> = {}) {
+  return JSON.stringify({
+    type: "user",
+    timestamp,
+    message: { role: "user", content: text },
+    ...extra,
+  });
+}
+
+function codexUser(text: string, timestamp: string) {
+  return JSON.stringify({
+    timestamp,
+    type: "response_item",
+    payload: { type: "message", role: "user", content: [{ type: "input_text", text }] },
+  });
+}
+
+describe("cleanPrompt", () => {
+  it("drops a message that is only an injected block", () => {
+    expect(
+      cleanPrompt('<paseo-system version="1" kind="agent-notification">done</paseo-system>'),
+    ).toBeNull();
+    expect(cleanPrompt("<command-name>/compact</command-name>")).toBeNull();
+  });
+
+  it("keeps what you typed after leading injected blocks", () => {
+    expect(cleanPrompt("<system-reminder>be brief</system-reminder>\n修一下侧栏时间")).toBe(
+      "修一下侧栏时间",
+    );
+  });
+
+  it("drops the Codex AGENTS.md preamble", () => {
+    expect(cleanPrompt("# AGENTS.md instructions for /repo\n\nfollow these")).toBeNull();
+  });
+});
+
+describe("transcript lines", () => {
+  it("reads a typed Claude prompt and skips tool results, meta and sidechain lines", () => {
+    const at = "2026-11-24T01:00:00.000Z";
+    expect(claudePromptFromLine(JSON.parse(claudeUser("hello", at)))).toEqual({
+      text: "hello",
+      sentAt: at,
+    });
+    expect(
+      claudePromptFromLine(
+        JSON.parse(claudeUser([{ type: "tool_result", tool_use_id: "t", content: "ok" }], at)),
+      ),
+    ).toBeNull();
+    expect(claudePromptFromLine(JSON.parse(claudeUser("x", at, { isMeta: true })))).toBeNull();
+    expect(claudePromptFromLine(JSON.parse(claudeUser("x", at, { isSidechain: true })))).toBeNull();
+    expect(
+      claudePromptFromLine(
+        JSON.parse(
+          claudeUser("This session is being continued from a previous conversation", at, {
+            isCompactSummary: true,
+            isVisibleInTranscriptOnly: true,
+          }),
+        ),
+      ),
+    ).toBeNull();
+  });
+
+  it("reads a Codex user message item and the older user_message event", () => {
+    const at = "2026-11-24T01:00:00.000Z";
+    expect(codexPromptFromLine(JSON.parse(codexUser("实现搜索", at)))).toEqual({
+      text: "实现搜索",
+      sentAt: at,
+    });
+    expect(
+      codexPromptFromLine({
+        timestamp: at,
+        type: "event_msg",
+        payload: { type: "user_message", message: "旧格式" },
+      }),
+    ).toEqual({ text: "旧格式", sentAt: at });
+  });
+});
+
+describe("promptSnippet", () => {
+  it("returns a short prompt whole and windows a long one around the match", () => {
+    expect(promptSnippet("  short\n prompt ", "short")).toBe("short prompt");
+    const long = `${"a".repeat(300)} needle ${"b".repeat(300)}`;
+    const snippet = promptSnippet(long, "needle");
+    expect(snippet).toContain("needle");
+    expect(snippet.startsWith("…")).toBe(true);
+    expect(snippet.endsWith("…")).toBe(true);
+  });
+});
+
+describe("readNewPrompts", () => {
+  let dir: string;
+  beforeEach(async () => {
+    dir = await mkdtemp(path.join(tmpdir(), "prompt-search-read-"));
+  });
+  afterEach(async () => {
+    await rm(dir, { recursive: true, force: true });
+  });
+
+  it("reads complete lines only, then continues from where it stopped", async () => {
+    const file = path.join(dir, "t.jsonl");
+    const first = claudeUser("first", "2026-11-24T01:00:00.000Z");
+    const second = claudeUser("second", "2026-11-24T01:01:00.000Z");
+    await writeFile(file, `${first}\n${second.slice(0, 20)}`);
+    const state = { format: "claude" as const, offset: 0, prompts: [] };
+
+    await readNewPrompts(file, state);
+    expect(state.prompts.map((p) => p.text)).toEqual(["first"]);
+    expect(state.offset).toBe(Buffer.byteLength(`${first}\n`));
+
+    await appendFile(file, `${second.slice(20)}\n`);
+    await readNewPrompts(file, state);
+    expect(state.prompts.map((p) => p.text)).toEqual(["first", "second"]);
+  });
+
+  it("starts over when the file was rewritten shorter", async () => {
+    const file = path.join(dir, "t.jsonl");
+    await writeFile(file, `${claudeUser("old one that is long", "2026-11-24T01:00:00.000Z")}\n`);
+    const state = { format: "claude" as const, offset: 0, prompts: [] };
+    await readNewPrompts(file, state);
+    await writeFile(file, `${claudeUser("new", "2026-11-24T02:00:00.000Z")}\n`);
+
+    await readNewPrompts(file, state);
+    expect(state.prompts.map((p) => p.text)).toEqual(["new"]);
+  });
+
+  it("keeps one of a Codex prompt written as both an item and an event", async () => {
+    const file = path.join(dir, "rollout.jsonl");
+    const at = "2026-11-24T01:00:00.000Z";
+    await writeFile(
+      file,
+      `${codexUser("same", at)}\n${JSON.stringify({ timestamp: at, type: "event_msg", payload: { type: "user_message", message: "same" } })}\n`,
+    );
+    const state = { format: "codex" as const, offset: 0, prompts: [] };
+    await readNewPrompts(file, state);
+    expect(state.prompts).toHaveLength(1);
+  });
+});
+
+describe("PromptSearchIndex", () => {
+  let root: string;
+  let workspace: string;
+  let claudeDir: string;
+  let codexHome: string;
+
+  beforeEach(async () => {
+    root = await realpath(await mkdtemp(path.join(tmpdir(), "prompt-search-index-")));
+    workspace = path.join(root, "repo");
+    claudeDir = path.join(root, "claude");
+    codexHome = path.join(root, "codex");
+    await mkdir(workspace, { recursive: true });
+  });
+  afterEach(async () => {
+    await rm(root, { recursive: true, force: true });
+  });
+
+  function record(overrides: Partial<StoredAgentRecord> & { id: string }): StoredAgentRecord {
+    return {
+      provider: "claude",
+      cwd: workspace,
+      title: null,
+      workspaceId: "wks_1",
+      archivedAt: null,
+      ...overrides,
+    } as StoredAgentRecord;
+  }
+
+  async function writeClaude(sessionId: string, lines: string[]) {
+    const dir = claudeProjectDirSync(workspace, { configDir: claudeDir });
+    await mkdir(dir, { recursive: true });
+    await writeFile(path.join(dir, `${sessionId}.jsonl`), `${lines.join("\n")}\n`);
+  }
+
+  async function writeCodex(threadId: string, lines: string[], archived = false) {
+    const dir = path.join(
+      codexHome,
+      archived ? "archived_sessions" : "sessions",
+      "2026",
+      "11",
+      "24",
+    );
+    await mkdir(dir, { recursive: true });
+    await writeFile(
+      path.join(dir, `rollout-2026-11-24T01-00-00-${threadId}.jsonl`),
+      `${lines.join("\n")}\n`,
+    );
+  }
+
+  function index(records: StoredAgentRecord[]) {
+    return new PromptSearchIndex({
+      listAgentRecords: async () => records,
+      listProviderEnvironments: () => [{ CLAUDE_CONFIG_DIR: claudeDir, CODEX_HOME: codexHome }],
+      cacheFile: path.join(root, "prompt-search-index.json"),
+      logger,
+    });
+  }
+
+  it("finds prompts across Claude and Codex chats, newest first, every term required", async () => {
+    const claudeSession = "11111111-1111-4111-8111-111111111111";
+    const codexThread = "01a1d922-baee-73c0-aa8c-2f69e66d27ae";
+    await writeClaude(claudeSession, [
+      claudeUser("侧栏时间不对", "2026-11-24T01:00:00.000Z"),
+      JSON.stringify({
+        type: "assistant",
+        timestamp: "2026-11-24T01:00:05.000Z",
+        message: { role: "assistant", content: "侧栏时间已修好" },
+      }),
+    ]);
+    await writeCodex(
+      codexThread,
+      [codexUser("再看看侧栏时间排序", "2026-11-24T02:00:00.000Z")],
+      true,
+    );
+    const records = [
+      record({
+        id: "a1",
+        title: "侧栏",
+        persistence: { provider: "claude", sessionId: claudeSession },
+      }),
+      record({
+        id: "a2",
+        provider: "codex-sub2",
+        archivedAt: "2026-11-24T03:00:00.000Z",
+        persistence: {
+          provider: "codex-sub2",
+          sessionId: codexThread,
+          metadata: { provider: "codex" },
+        },
+      }),
+    ];
+
+    const result = await index(records).search("侧栏 时间");
+
+    expect(result.matches.map((m) => [m.agentId, m.text])).toEqual([
+      ["a2", "再看看侧栏时间排序"],
+      ["a1", "侧栏时间不对"],
+    ]);
+    expect(result.matches[0].archived).toBe(true);
+    expect((await index(records).search("侧栏 回复")).matches).toEqual([]);
+  });
+
+  it("serves a restarted daemon from the saved index and reads only what was appended", async () => {
+    const session = "22222222-2222-4222-8222-222222222222";
+    await writeClaude(session, [claudeUser("first prompt", "2026-11-24T01:00:00.000Z")]);
+    const records = [record({ id: "a1", persistence: { provider: "claude", sessionId: session } })];
+    await index(records).search("prompt");
+
+    const dir = claudeProjectDirSync(workspace, { configDir: claudeDir });
+    await appendFile(
+      path.join(dir, `${session}.jsonl`),
+      `${claudeUser("second prompt", "2026-11-24T02:00:00.000Z")}\n`,
+    );
+
+    const result = await index(records).search("prompt");
+    expect(result.matches.map((m) => m.text)).toEqual(["second prompt", "first prompt"]);
+  });
+
+  it("leaves out subagents and background agents, whose prompts another agent wrote", async () => {
+    const session = "44444444-4444-4444-8444-444444444444";
+    await writeClaude(session, [claudeUser("implement the parser", "2026-11-24T01:00:00.000Z")]);
+    const persistence = { provider: "claude", sessionId: session };
+    const sub = record({ id: "sub", persistence, labels: { "paseo.parent-agent-id": "root" } });
+    const bg = record({ id: "bg", persistence, background: true });
+
+    expect((await index([sub, bg]).search("parser")).matches).toEqual([]);
+  });
+
+  it("reports truncation past the limit", async () => {
+    const session = "33333333-3333-4333-8333-333333333333";
+    await writeClaude(session, [
+      claudeUser("deploy one", "2026-11-24T01:00:00.000Z"),
+      claudeUser("deploy two", "2026-11-24T02:00:00.000Z"),
+    ]);
+    const records = [record({ id: "a1", persistence: { provider: "claude", sessionId: session } })];
+
+    const result = await index(records).search("deploy", 1);
+    expect(result.matches.map((m) => m.text)).toEqual(["deploy two"]);
+    expect(result.truncated).toBe(true);
+  });
+});
