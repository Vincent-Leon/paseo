@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { mergePromptHits } from "./prompt-search";
+
+function match(agentId: string, sentAt: string) {
+  return {
+    agentId,
+    agentTitle: null,
+    workspaceId: null,
+    provider: "claude",
+    text: agentId,
+    sentAt,
+    archived: false,
+  };
+}
+
+describe("mergePromptHits", () => {
+  it("merges hosts newest first and keeps the limit", () => {
+    const hits = mergePromptHits(
+      [
+        {
+          serverId: "a",
+          matches: [
+            match("a1", "2026-11-24T01:00:00.000Z"),
+            match("a2", "2026-11-22T01:00:00.000Z"),
+          ],
+        },
+        { serverId: "b", matches: [match("b1", "2026-11-23T01:00:00.000Z")] },
+      ],
+      2,
+    );
+
+    expect(hits.map((hit) => [hit.serverId, hit.agentId])).toEqual([
+      ["a", "a1"],
+      ["b", "b1"],
+    ]);
+  });
+});
diff --git a/packages/app/src/command-center/prompt-search.ts b/packages/app/src/command-center/prompt-search.ts
new file mode 100644
index 000000000..c30b3ec41
--- /dev/null
+++ b/packages/app/src/command-center/prompt-search.ts
@@ -0,0 +1,86 @@
+import type { AgentPromptSearchMatch } from "@getpaseo/protocol/messages";
+import { useMemo } from "react";
+import { useShallow } from "zustand/shallow";
+import { useFetchQuery } from "@/data/query";
+import { useDebouncedValue } from "@/hooks/use-debounced-value";
+import {
+  getHostRuntimeStore,
+  useHostRuntimeConnectionStatuses,
+  useHosts,
+} from "@/runtime/host-runtime";
+import { useSessionStore } from "@/stores/session-store";
+
+const SEARCH_DEBOUNCE_MS = 250;
+const PROMPT_LIMIT = 20;
+const NO_HITS: PromptSearchHit[] = [];
+
+export interface PromptSearchHit extends AgentPromptSearchMatch {
+  serverId: string;
+}
+
+export interface PromptSearch {
+  /** Newest first across hosts. Empty without a query. */
+  hits: readonly PromptSearchHit[];
+  /** Still searching for the current query, debounce included. */
+  pending: boolean;
+}
+
+/** Newest first, at most `limit`, from every host's answer. */
+export function mergePromptHits(
+  answers: ReadonlyArray<{ serverId: string; matches: readonly AgentPromptSearchMatch[] }>,
+  limit = PROMPT_LIMIT,
+): PromptSearchHit[] {
+  return answers
+    .flatMap(({ serverId, matches }) => matches.map((match) => ({ ...match, serverId })))
+    .sort((left, right) => right.sentAt.localeCompare(left.sentAt))
+    .slice(0, limit);
+}
+
+/**
+ * Prompts you sent that match `query`, searched on every online host that supports prompt
+ * search. A host that fails or predates it contributes nothing; the other hosts still answer.
+ */
+export function usePromptSearch(query: string, options: { enabled: boolean }): PromptSearch {
+  const trimmed = query.trim();
+  const search = useDebouncedValue(trimmed, SEARCH_DEBOUNCE_MS);
+  const hosts = useHosts();
+  const serverIds = useMemo(() => hosts.map((host) => host.serverId), [hosts]);
+  const capableIds = useSessionStore(
+    useShallow((state) =>
+      serverIds.filter((id) => state.sessions[id]?.serverInfo?.features?.promptSearch === true),
+    ),
+  );
+  const statuses = useHostRuntimeConnectionStatuses(capableIds);
+  const onlineIds = useMemo(
+    () => capableIds.filter((id) => statuses.get(id) === "online"),
+    [capableIds, statuses],
+  );
+  const wanted = options.enabled && trimmed.length > 0 && onlineIds.length > 0;
+  const enabled = wanted && search.length > 0;
+
+  const result = useFetchQuery({
+    queryKey: ["command-center", "prompt-search", onlineIds, search],
+    enabled,
+    dataShape: "list",
+    staleTimeMs: 30_000,
+    queryFn: async () => {
+      const runtime = getHostRuntimeStore();
+      const answers = await Promise.allSettled(
+        onlineIds.map(async (serverId) => {
+          const client = runtime.getClient(serverId);
+          if (!client) return { serverId, matches: [] };
+          const payload = await client.searchAgentPrompts({ query: search, limit: PROMPT_LIMIT });
+          return { serverId, matches: payload.error ? [] : payload.matches };
+        }),
+      );
+      return mergePromptHits(
+        answers.flatMap((answer) => (answer.status === "fulfilled" ? [answer.value] : [])),
+      );
+    },
+  });
+
+  return {
+    hits: enabled && result.data ? result.data : NO_HITS,
+    pending: wanted && (search !== trimmed || result.isFetching),
+  };
+}
