@@ -0,0 +1,418 @@
+import { open, readdir, readFile, stat } from "node:fs/promises";
+import { homedir } from "node:os";
+import path from "node:path";
+import type { Logger } from "pino";
+import { z } from "zod";
+import { getParentAgentIdFromLabels } from "@getpaseo/protocol/agent-labels";
+import type { AgentPromptSearchMatch } from "@getpaseo/protocol/messages";
+import { writeJsonFileAtomic } from "../atomic-file.js";
+import type { StoredAgentRecord } from "./agent-storage.js";
+import { claudeConfigDir, claudeTranscriptPath } from "./providers/claude/project-dir.js";
+
+/**
+ * Searches the prompts you sent, read straight from the provider transcripts on disk (Claude
+ * Code's `projects/<dir>/<session>.jsonl`, Codex's `sessions/**\/rollout-*-<thread>.jsonl`).
+ * Nothing is resumed to read them: reopening a closed chat restamps its activity time, and a
+ * provider runtime per chat would be far heavier than reading a file.
+ *
+ * Transcripts only grow, so each one is read once and then from where the last read stopped.
+ * The prompts and read offsets persist in `cacheFile`, so a daemon restart does not reread
+ * gigabytes of history.
+ */
+
+const READ_CHUNK_BYTES = 4 * 1024 * 1024;
+const MAX_PROMPT_CHARS = 20_000;
+const SNIPPET_CHARS = 160;
+const MISSING_TRANSCRIPT_RETRY_MS = 10 * 60 * 1000;
+const DEFAULT_LIMIT = 20;
+// Bump when the rules for what counts as your prompt change: the saved index holds prompts already
+// filtered, so a new rule only reaches old transcripts through a rebuild.
+const CACHE_VERSION = 1;
+
+type TranscriptFormat = "claude" | "codex";
+
+export interface IndexedPrompt {
+  text: string;
+  sentAt: string;
+}
+
+interface TranscriptState {
+  format: TranscriptFormat;
+  /** Bytes consumed: always the end of the last complete line read. */
+  offset: number;
+  prompts: IndexedPrompt[];
+}
+
+const TranscriptStateSchema = z.object({
+  format: z.enum(["claude", "codex"]),
+  offset: z.number().int().nonnegative(),
+  prompts: z.array(z.object({ text: z.string(), sentAt: z.string() })),
+});
+
+const CacheFileSchema = z.object({
+  version: z.literal(CACHE_VERSION),
+  transcripts: z.record(z.string(), TranscriptStateSchema),
+});
+
+export interface PromptSearchResult {
+  matches: AgentPromptSearchMatch[];
+  truncated: boolean;
+}
+
+export interface PromptSearchDeps {
+  listAgentRecords(): Promise<StoredAgentRecord[]>;
+  /**
+   * Environments the configured providers launch with. Their CLAUDE_CONFIG_DIR and CODEX_HOME
+   * say where transcripts are written besides the defaults.
+   */
+  listProviderEnvironments(): ReadonlyArray<Record<string, string | undefined>>;
+  cacheFile: string;
+  logger: Logger;
+}
+
+// Blocks the provider or Paseo injects into the user role: Paseo notifications, task and
+// slash-command output, system reminders, Codex's environment and instruction preambles.
+const INJECTED_BLOCK = /^\s*<([a-zA-Z][\w-]*)\b[^>]*>[\s\S]*?<\/\1>\s*/;
+const AGENTS_PREAMBLE = /^\s*# AGENTS\.md instructions\b/;
+
+/** What you typed, without injected blocks around it. Null when nothing you typed is left. */
+export function cleanPrompt(raw: string): string | null {
+  let text = raw;
+  for (;;) {
+    const match = INJECTED_BLOCK.exec(text);
+    if (!match) break;
+    text = text.slice(match[0].length);
+  }
+  if (AGENTS_PREAMBLE.test(text)) return null;
+  const trimmed = text.trim();
+  if (!trimmed) return null;
+  return trimmed.length > MAX_PROMPT_CHARS ? trimmed.slice(0, MAX_PROMPT_CHARS) : trimmed;
+}
+
+function textParts(content: unknown, partType: string): string[] {
+  if (typeof content === "string") return [content];
+  if (!Array.isArray(content)) return [];
+  return content.flatMap((part) =>
+    part && typeof part === "object" && (part as { type?: unknown }).type === partType
+      ? [String((part as { text?: unknown }).text ?? "")]
+      : [],
+  );
+}
+
+/**
+ * A Claude Code transcript line's prompt: a top-level user message with text you typed. Meta
+ * lines, subagent sidechains and the summary Claude Code writes after compacting the context
+ * are user-role too.
+ */
+export function claudePromptFromLine(entry: Record<string, unknown>): IndexedPrompt | null {
+  if (
+    entry.type !== "user" ||
+    entry.isMeta === true ||
+    entry.isSidechain === true ||
+    entry.isCompactSummary === true ||
+    entry.isVisibleInTranscriptOnly === true
+  ) {
+    return null;
+  }
+  const message = entry.message as { role?: unknown; content?: unknown } | undefined;
+  if (!message || message.role !== "user" || typeof entry.timestamp !== "string") return null;
+  const text = cleanPrompt(textParts(message.content, "text").join("\n"));
+  return text ? { text, sentAt: entry.timestamp } : null;
+}
+
+/** A Codex rollout line's prompt: a user-role message item, or the older user_message event. */
+export function codexPromptFromLine(entry: Record<string, unknown>): IndexedPrompt | null {
+  if (typeof entry.timestamp !== "string") return null;
+  const payload = entry.payload as Record<string, unknown> | undefined;
+  if (!payload) return null;
+  let raw: string | null = null;
+  if (entry.type === "response_item" && payload.type === "message" && payload.role === "user") {
+    raw = textParts(payload.content, "input_text").join("\n");
+  } else if (entry.type === "event_msg" && payload.type === "user_message") {
+    raw = typeof payload.message === "string" ? payload.message : null;
+  }
+  const text = raw === null ? null : cleanPrompt(raw);
+  return text ? { text, sentAt: entry.timestamp } : null;
+}
+
+// Cheap substring tests that rule out most lines before JSON.parse.
+const LINE_PREFILTER: Record<TranscriptFormat, (line: string) => boolean> = {
+  claude: (line) => line.includes('"type":"user"'),
+  codex: (line) => line.includes('"role":"user"') || line.includes('"user_message"'),
+};
+
+const LINE_PARSERS: Record<
+  TranscriptFormat,
+  (entry: Record<string, unknown>) => IndexedPrompt | null
+> = {
+  claude: claudePromptFromLine,
+  codex: codexPromptFromLine,
+};
+
+/**
+ * Older Codex versions wrote a prompt both as a message item and as a user_message event. Keep
+ * one: a prompt whose text repeats the previous one within a few seconds is that echo.
+ */
+function isEcho(previous: IndexedPrompt | undefined, next: IndexedPrompt): boolean {
+  if (!previous || previous.text !== next.text) return false;
+  return Math.abs(Date.parse(next.sentAt) - Date.parse(previous.sentAt)) < 5_000;
+}
+
+/** Reads the complete lines after `state.offset` and appends their prompts. */
+export async function readNewPrompts(filePath: string, state: TranscriptState): Promise<void> {
+  const handle = await open(filePath, "r");
+  try {
+    const { size } = await handle.stat();
+    if (size < state.offset) {
+      // Rewritten rather than appended to: start over.
+      state.offset = 0;
+      state.prompts = [];
+    }
+    const buffer = Buffer.alloc(READ_CHUNK_BYTES);
+    let carry = Buffer.alloc(0);
+    let position = state.offset;
+    while (position < size) {
+      const { bytesRead } = await handle.read(
+        buffer,
+        0,
+        Math.min(READ_CHUNK_BYTES, size - position),
+        position,
+      );
+      if (bytesRead === 0) break;
+      position += bytesRead;
+      const chunk = carry.length ? Buffer.concat([carry, buffer.subarray(0, bytesRead)]) : buffer;
+      const end = carry.length ? chunk.length : bytesRead;
+      const lastNewline = chunk.lastIndexOf(0x0a, end - 1);
+      if (lastNewline < 0) {
+        carry = Buffer.from(chunk.subarray(0, end));
+        continue;
+      }
+      const complete = chunk.subarray(0, lastNewline + 1).toString("utf8");
+      carry = Buffer.from(chunk.subarray(lastNewline + 1, end));
+      state.offset = position - carry.length;
+      for (const line of complete.split("\n")) {
+        if (!line || !LINE_PREFILTER[state.format](line)) continue;
+        let entry: unknown;
+        try {
+          entry = JSON.parse(line);
+        } catch {
+          continue;
+        }
+        if (!entry || typeof entry !== "object") continue;
+        const prompt = LINE_PARSERS[state.format](entry as Record<string, unknown>);
+        if (prompt && !isEcho(state.prompts.at(-1), prompt)) state.prompts.push(prompt);
+      }
+    }
+  } finally {
+    await handle.close();
+  }
+}
+
+function normalize(text: string): string {
+  return text.toLocaleLowerCase();
+}
+
+/** The prompt shortened to a window around the first matched term, whitespace collapsed. */
+export function promptSnippet(text: string, term: string): string {
+  const collapsed = text.replace(/\s+/g, " ").trim();
+  if (collapsed.length <= SNIPPET_CHARS) return collapsed;
+  const at = Math.max(0, normalize(collapsed).indexOf(term));
+  const start = Math.max(
+    0,
+    Math.min(at - Math.floor(SNIPPET_CHARS / 4), collapsed.length - SNIPPET_CHARS),
+  );
+  const window = collapsed.slice(start, start + SNIPPET_CHARS);
+  return `${start > 0 ? "…" : ""}${window}${start + SNIPPET_CHARS < collapsed.length ? "…" : ""}`;
+}
+
+function transcriptFormat(record: StoredAgentRecord): TranscriptFormat | null {
+  const native = record.persistence?.metadata?.provider ?? record.provider;
+  return native === "claude" || native === "codex" ? native : null;
+}
+
+async function exists(filePath: string): Promise<boolean> {
+  try {
+    await stat(filePath);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function collectRollouts(dir: string, into: Map<string, string>): Promise<void> {
+  let entries;
+  try {
+    entries = await readdir(dir, { withFileTypes: true });
+  } catch {
+    return;
+  }
+  for (const entry of entries) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      await collectRollouts(full, into);
+      continue;
+    }
+    // rollout-<timestamp>-<thread id>.jsonl; the thread id is the last five UUID groups.
+    const match = /-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/i.exec(
+      entry.name,
+    );
+    if (entry.name.startsWith("rollout-") && match) into.set(match[1].toLowerCase(), full);
+  }
+}
+
+export class PromptSearchIndex {
+  private transcripts = new Map<string, TranscriptState>();
+  private transcriptByAgent = new Map<string, string>();
+  private missingSince = new Map<string, number>();
+  private rollouts: Map<string, string> | null = null;
+  private loaded = false;
+  private refreshing: Promise<void> | null = null;
+
+  constructor(private readonly deps: PromptSearchDeps) {}
+
+  async search(query: string, limit = DEFAULT_LIMIT): Promise<PromptSearchResult> {
+    const terms = normalize(query).split(/\s+/).filter(Boolean);
+    if (terms.length === 0) return { matches: [], truncated: false };
+    const records = await this.refresh();
+    const found: AgentPromptSearchMatch[] = [];
+    for (const record of records) {
+      const transcript = this.transcriptByAgent.get(record.id);
+      const state = transcript ? this.transcripts.get(transcript) : undefined;
+      if (!state) continue;
+      for (const prompt of state.prompts) {
+        const haystack = normalize(prompt.text);
+        if (!terms.every((term) => haystack.includes(term))) continue;
+        found.push({
+          agentId: record.id,
+          agentTitle: record.title ?? null,
+          workspaceId: record.workspaceId ?? null,
+          provider: record.provider,
+          text: promptSnippet(prompt.text, terms[0]),
+          sentAt: prompt.sentAt,
+          archived: Boolean(record.archivedAt),
+        });
+      }
+    }
+    found.sort((a, b) => b.sentAt.localeCompare(a.sentAt));
+    return { matches: found.slice(0, limit), truncated: found.length > limit };
+  }
+
+  /**
+   * Brings every chat's transcript up to date. Concurrent searches share one refresh. Subagents
+   * and background agents are left out: what their transcripts hold in the user role was written
+   * by the agent that started or drives them, not by you.
+   */
+  private async refresh(): Promise<StoredAgentRecord[]> {
+    const records = (await this.deps.listAgentRecords()).filter(
+      (record) =>
+        !record.internal &&
+        !record.background &&
+        !getParentAgentIdFromLabels(record.labels) &&
+        record.persistence?.sessionId &&
+        transcriptFormat(record),
+    );
+    if (!this.refreshing) {
+      this.refreshing = this.update(records).finally(() => {
+        this.refreshing = null;
+      });
+    }
+    await this.refreshing;
+    return records;
+  }
+
+  private async update(records: StoredAgentRecord[]): Promise<void> {
+    await this.load();
+    this.rollouts = null;
+    let changed = false;
+    for (const record of records) {
+      const transcript = await this.locate(record);
+      if (!transcript) continue;
+      const format = transcriptFormat(record)!;
+      const state = this.transcripts.get(transcript) ?? { format, offset: 0, prompts: [] };
+      const before = state.offset;
+      try {
+        await readNewPrompts(transcript, state);
+      } catch (error) {
+        this.deps.logger.warn({ err: error, transcript }, "Failed to read transcript prompts");
+        continue;
+      }
+      this.transcripts.set(transcript, state);
+      if (state.offset !== before) changed = true;
+    }
+    if (changed) await this.save();
+  }
+
+  private async locate(record: StoredAgentRecord): Promise<string | null> {
+    const known = this.transcriptByAgent.get(record.id);
+    if (known && (await exists(known))) return known;
+    const missing = this.missingSince.get(record.id);
+    if (missing && Date.now() - missing < MISSING_TRANSCRIPT_RETRY_MS) return null;
+    const sessionId = record.persistence!.sessionId;
+    const found =
+      transcriptFormat(record) === "claude"
+        ? await this.locateClaude(record, sessionId)
+        : await this.locateCodex(sessionId);
+    if (found) {
+      this.transcriptByAgent.set(record.id, found);
+      this.missingSince.delete(record.id);
+    } else {
+      this.missingSince.set(record.id, Date.now());
+    }
+    return found;
+  }
+
+  private async locateClaude(record: StoredAgentRecord, sessionId: string): Promise<string | null> {
+    const cwd = record.persistence?.metadata?.cwd ?? record.cwd;
+    if (typeof cwd !== "string") return null;
+    for (const configDir of this.envDirs("CLAUDE_CONFIG_DIR", claudeConfigDir(process.env))) {
+      const candidate = await claudeTranscriptPath({ cwd, sessionId, configDir });
+      if (await exists(candidate)) return candidate;
+    }
+    return null;
+  }
+
+  private async locateCodex(threadId: string): Promise<string | null> {
+    if (!this.rollouts) {
+      this.rollouts = new Map();
+      const defaultHome = process.env.CODEX_HOME ?? path.join(homedir(), ".codex");
+      for (const home of this.envDirs("CODEX_HOME", defaultHome)) {
+        await collectRollouts(path.join(home, "sessions"), this.rollouts);
+        await collectRollouts(path.join(home, "archived_sessions"), this.rollouts);
+      }
+    }
+    return this.rollouts.get(threadId.toLowerCase()) ?? null;
+  }
+
+  private envDirs(name: string, fallback: string): string[] {
+    const dirs = new Set([path.resolve(fallback)]);
+    for (const env of this.deps.listProviderEnvironments()) {
+      const value = env[name];
+      if (value) dirs.add(path.resolve(value));
+    }
+    return [...dirs];
+  }
+
+  private async load(): Promise<void> {
+    if (this.loaded) return;
+    this.loaded = true;
+    try {
+      const parsed = CacheFileSchema.safeParse(
+        JSON.parse(await readFile(this.deps.cacheFile, "utf8")),
+      );
+      if (parsed.success) this.transcripts = new Map(Object.entries(parsed.data.transcripts));
+    } catch {
+      // No index yet, or an unreadable one: rebuild from the transcripts.
+    }
+  }
+
+  private async save(): Promise<void> {
+    try {
+      await writeJsonFileAtomic(this.deps.cacheFile, {
+        version: CACHE_VERSION,
+        transcripts: Object.fromEntries(this.transcripts),
+      });
+    } catch (error) {
+      this.deps.logger.warn({ err: error }, "Failed to save the prompt search index");
+    }
+  }
+}
