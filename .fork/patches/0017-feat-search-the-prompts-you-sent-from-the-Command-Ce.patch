@@ -0,0 +1,92 @@
+import { randomUUID } from "node:crypto";
+import { mkdir, mkdtemp, realpath, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { afterEach, expect, test } from "vitest";
+import { AgentStorage, type StoredAgentRecord } from "./agent/agent-storage.js";
+import { claudeProjectDirSync } from "./agent/providers/claude/project-dir.js";
+import { DaemonClient } from "./test-utils/daemon-client.js";
+import { createTestPaseoDaemon, type TestPaseoDaemon } from "./test-utils/paseo-daemon.js";
+
+let daemon: TestPaseoDaemon | null = null;
+let client: DaemonClient | null = null;
+let root: string | null = null;
+
+afterEach(async () => {
+  await client?.close().catch(() => {});
+  await daemon?.close();
+  if (root) await rm(root, { recursive: true, force: true });
+  client = null;
+  daemon = null;
+  root = null;
+});
+
+test("searches the prompts you sent in a stored chat, not its replies", async () => {
+  root = await realpath(await mkdtemp(path.join(os.tmpdir(), "prompt-search-e2e-")));
+  const repo = path.join(root, "repo");
+  const claudeDir = path.join(root, "claude");
+  const paseoHomeRoot = path.join(root, "home");
+  const sessionId = randomUUID();
+  await mkdir(repo, { recursive: true });
+
+  const projectDir = claudeProjectDirSync(repo, { configDir: claudeDir });
+  await mkdir(projectDir, { recursive: true });
+  await writeFile(
+    path.join(projectDir, `${sessionId}.jsonl`),
+    [
+      {
+        type: "user",
+        timestamp: "2026-11-24T01:00:00.000Z",
+        message: { role: "user", content: "侧栏时间不对" },
+      },
+      {
+        type: "assistant",
+        timestamp: "2026-11-24T01:00:05.000Z",
+        message: { role: "assistant", content: [{ type: "text", text: "侧栏时间已修好" }] },
+      },
+    ]
+      .map((line) => JSON.stringify(line))
+      .join("\n") + "\n",
+  );
+
+  // Stored before the daemon starts, as a chat from an earlier run would be.
+  const storage = new AgentStorage(
+    path.join(paseoHomeRoot, ".paseo", "agents"),
+    pino({ level: "silent" }),
+  );
+  const now = "2026-11-24T01:00:00.000Z";
+  await storage.upsert({
+    id: "agent-1",
+    provider: "claude",
+    cwd: repo,
+    createdAt: now,
+    updatedAt: now,
+    title: "侧栏",
+    labels: {},
+    config: {},
+    persistence: { provider: "claude", sessionId },
+  } as unknown as StoredAgentRecord);
+  await storage.flush();
+
+  daemon = await createTestPaseoDaemon({
+    paseoHomeRoot,
+    providerOverrides: { claude: { env: { CLAUDE_CONFIG_DIR: claudeDir } } },
+  });
+  client = new DaemonClient({
+    url: `ws://127.0.0.1:${daemon.port}/ws`,
+    clientId: `cid-e2e-${randomUUID()}`,
+    clientType: "cli",
+  });
+  await client.connect();
+  expect(client.getLastServerInfoMessage()?.features?.promptSearch).toBe(true);
+
+  const found = await client.searchAgentPrompts({ query: "侧栏 时间" });
+  expect(found.error).toBeNull();
+  expect(found.matches.map((match) => [match.agentId, match.agentTitle, match.text])).toEqual([
+    ["agent-1", "侧栏", "侧栏时间不对"],
+  ]);
+
+  const reply = await client.searchAgentPrompts({ query: "已修好" });
+  expect(reply.matches).toEqual([]);
+}, 60_000);
