+
+/**
+ * A finished workspace is placed at the last prompt sent there, not at when it entered `done`.
+ * The daemon reopens closed chats to read their history whenever an app connects, and that
+ * reopening restamps the done entry time, so a workspace untouched for days showed as just used.
+ * The last prompt only moves when you send one. Live buckets keep their entry time: "running for
+ * 5 min" is what they mean.
+ */
+export function workspaceListTime(input: {
+  status: WorkspaceDescriptor["status"];
+  enteredAt: Date | null;
+  lastUserMessageAt: Date | null;
+}): Date | null {
+  if (input.status !== "done") return input.enteredAt;
+  return input.lastUserMessageAt ?? input.enteredAt;
+}
