+describe("createSidebarWorkspaceEntry sidebar time", () => {
+  const finishedAt = new Date("2026-11-24T09:25:47.000Z");
+  const promptedAt = new Date("2026-11-20T10:53:00.000Z");
+
+  function entryFor(overrides: Partial<WorkspaceDescriptor>) {
+    return createSidebarWorkspaceEntry({
+      serverId: "srv",
+      workspace: { ...workspaceWithForge("github", "https://github.com/o/r/pull/1"), ...overrides },
+    });
+  }
+
+  it("shows a finished workspace at the last prompt sent there", () => {
+    const entry = entryFor({
+      status: "done",
+      statusEnteredAt: finishedAt,
+      lastUserMessageAt: promptedAt,
+    });
+
+    expect(entry.statusEnteredAt).toEqual(promptedAt);
+  });
+
+  it("keeps the done entry time for a finished workspace that never got a prompt", () => {
+    const entry = entryFor({
+      status: "done",
+      statusEnteredAt: finishedAt,
+      lastUserMessageAt: null,
+    });
+
+    expect(entry.statusEnteredAt).toEqual(finishedAt);
+  });
+
+  it("keeps the bucket entry time for a live workspace", () => {
+    const entry = entryFor({
+      status: "running",
+      statusEnteredAt: finishedAt,
+      lastUserMessageAt: promptedAt,
+    });
+
+    expect(entry.statusEnteredAt).toEqual(finishedAt);
+  });
+});
