@@ -0,0 +1,23 @@
+export interface AlertDecisionInput {
+  /** The daemon's per-client verdict for this alert. */
+  shouldNotify: boolean;
+  /** This device takes alerts over its connection rather than by push. */
+  alertsOverConnection: boolean;
+  /** The daemon advertises `alertsOverConnection` and routes such devices itself. */
+  daemonRoutesConnectionAlerts: boolean;
+  appActivelyVisible: boolean;
+}
+
+/**
+ * Whether this device shows an alert. The daemon's per-client verdict decides, because it knows
+ * which other clients are present.
+ */
+export function shouldShowAlert(input: AlertDecisionInput): boolean {
+  if (input.shouldNotify) return true;
+  // COMPAT(alertsOverConnection): a daemon without the feature pushes when no client is present,
+  // and this device takes no push, so alert whenever Paseo is not in front. That can double an
+  // alert with a present desktop. Remove once every fork daemon advertises alertsOverConnection.
+  return (
+    input.alertsOverConnection && !input.daemonRoutesConnectionAlerts && !input.appActivelyVisible
+  );
+}
