+/**
+ * Whether one client is told to show an alert. The plan's in-app recipient always is. A client
+ * that takes alerts over its connection stands in for push, so it is alerted exactly when the
+ * plan pushes: no client is present, and a present one keeps the alert to itself.
+ */
+export function receivesAlert(input: {
+  plan: NotificationPlan;
+  isInAppRecipient: boolean;
+  state: ClientPresenceState;
+}): boolean {
+  return input.isInAppRecipient || (input.plan.shouldPush && input.state.alertsOverConnection);
+}
+
 export function isPushEligibleAttentionReason(reason: AgentAttentionReason): boolean {
   return reason !== "error";
 }
