@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { shouldShowAlert } from "./alerts";
+
+const base = {
+  shouldNotify: false,
+  alertsOverConnection: false,
+  daemonRoutesConnectionAlerts: false,
+  appActivelyVisible: false,
+};
+
+describe("shouldShowAlert", () => {
+  it("follows the daemon when it marks an alert for this device", () => {
+    expect(shouldShowAlert({ ...base, shouldNotify: true })).toBe(true);
+    expect(shouldShowAlert({ ...base, shouldNotify: true, alertsOverConnection: true })).toBe(true);
+  });
+
+  it("stays quiet without the daemon's mark when alerts come by push", () => {
+    expect(shouldShowAlert(base)).toBe(false);
+  });
+
+  it("trusts a daemon that routes alerts to connection-alert devices itself", () => {
+    expect(
+      shouldShowAlert({
+        ...base,
+        alertsOverConnection: true,
+        daemonRoutesConnectionAlerts: true,
+      }),
+    ).toBe(false);
+  });
+
+  it("alerts in the background when an older daemon would push to a device that takes no push", () => {
+    const olderDaemon = { ...base, alertsOverConnection: true };
+
+    expect(shouldShowAlert(olderDaemon)).toBe(true);
+    expect(shouldShowAlert({ ...olderDaemon, appActivelyVisible: true })).toBe(false);
+  });
+});
