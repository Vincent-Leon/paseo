+test("a custom provider shows its configured icon instead of its base provider's", () => {
+  const icon = '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M2 2h20v20H2z"/></svg>';
+  const registry = buildProviderRegistry(logger, {
+    providerOverrides: {
+      "codex-gateway": { extends: "codex", label: "Codex (gateway)", icon },
+      "codex-plain": { extends: "codex", label: "Codex (plain)" },
