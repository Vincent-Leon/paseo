+const PROVIDER_ICON_MAX_LENGTH = 32_768;
+
+// Clients draw provider icons with react-native-svg, tinted through currentColor. A configured
+// icon reaches every client connected to the daemon, so it may not run script or pull in
+// anything from outside the document.
+const PROVIDER_ICON_FORBIDDEN: readonly [RegExp, string][] = [
+  [/<\s*script\b/i, "must not contain <script>"],
+  [/<\s*foreignObject\b/i, "must not contain <foreignObject>"],
+  [/\son[a-z]+\s*=/i, "must not contain event handler attributes"],
+  [/javascript:/i, "must not contain javascript: URLs"],
+  [/\bhref\s*=(?!\s*["']?\s*#)/i, "may only link to fragments inside the icon (#id)"],
+  [/url\((?!\s*["']?\s*#)/i, "may only reference fragments inside the icon (url(#id))"],
+  [/@import\b/i, "must not import stylesheets"],
+];
+
+/** Why an `icon` value cannot be used as a provider icon, or null when it can. */
+export function describeProviderIconProblem(icon: string): string | null {
+  const svg = icon.trim();
+  if (svg.length > PROVIDER_ICON_MAX_LENGTH) {
+    return `must be at most ${PROVIDER_ICON_MAX_LENGTH} characters`;
+  }
+  if (!/^<svg[\s>]/i.test(svg) || !/<\/svg>$/i.test(svg)) {
+    return "must be a single <svg> element";
+  }
+  for (const [pattern, problem] of PROVIDER_ICON_FORBIDDEN) {
+    if (pattern.test(svg)) return problem;
+  }
+  return null;
+}
+
 const BUILTIN_PROVIDER_IDS = ["claude", "codex", "copilot", "opencode", "pi", "omp"] as const;
 const PROVIDER_ID_PATTERN = /^[a-z][a-z0-9-]*$/;
 
