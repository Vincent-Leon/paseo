diff --git a/packages/protocol/src/provider-config.test.ts b/packages/protocol/src/provider-config.test.ts
new file mode 100644
index 000000000..425065e19
--- /dev/null
+++ b/packages/protocol/src/provider-config.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, test } from "vitest";
+import { describeProviderIconProblem, ProviderOverridesSchema } from "./provider-config.js";
+
+const ICON =
+  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M2 2h20v20H2z"/></svg>';
+
+function iconIssues(icon: string): string[] {
+  const parsed = ProviderOverridesSchema.safeParse({
+    "codex-gateway": { extends: "codex", label: "Codex (gateway)", icon },
+  });
+  return parsed.success ? [] : parsed.error.issues.map((issue) => issue.path.join("."));
+}
+
+describe("provider icons", () => {
+  test("a custom provider keeps a self-contained SVG icon", () => {
+    const parsed = ProviderOverridesSchema.parse({
+      "codex-gateway": { extends: "codex", label: "Codex (gateway)", icon: ICON },
+    });
+
+    expect(parsed["codex-gateway"]?.icon).toBe(ICON);
+  });
+
+  test("an icon may reference its own gradients and symbols", () => {
+    const icon =
+      '<svg viewBox="0 0 24 24"><defs><linearGradient id="g"/><path id="p" d="M0 0h1v1z"/></defs>' +
+      '<rect fill="url(#g)" width="24" height="24"/><use href="#p"/><use xlink:href = \'#p\'/></svg>';
+
+    expect(describeProviderIconProblem(icon)).toBeNull();
+  });
+
+  test.each([
+    ["not an svg", "<div>icon</div>"],
+    ["script", "<svg><script>alert(1)</script></svg>"],
+    ["event handler", '<svg onload="alert(1)"></svg>'],
+    ["foreign object", "<svg><foreignObject><div/></foreignObject></svg>"],
+    ["external link", '<svg><image href="https://example.com/i.png"/></svg>'],
+    ["external url", '<svg><rect fill="url( https://example.com/p.svg#g)"/></svg>'],
+    ["javascript url", '<svg><a href="javascript:alert(1)"/></svg>'],
+    ["oversized", `<svg>${"<g/>".repeat(9000)}</svg>`],
+  ])("rejects an icon with %s", (_case, icon) => {
+    expect(iconIssues(icon)).toEqual(["codex-gateway.icon"]);
+  });
+});
