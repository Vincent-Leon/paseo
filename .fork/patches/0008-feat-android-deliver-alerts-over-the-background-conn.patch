diff --git a/packages/app/src/background-connection/notifications.native.ts b/packages/app/src/background-connection/notifications.native.ts
new file mode 100644
index 000000000..d62aebc79
--- /dev/null
+++ b/packages/app/src/background-connection/notifications.native.ts
@@ -0,0 +1,46 @@
+import * as Notifications from "expo-notifications";
+import { i18n } from "@/i18n/i18next";
+
+const ALERTS_CHANNEL_ID = "paseo-agent-alerts";
+
+let alertsChannel: Promise<unknown> | null = null;
+
+function ensureAlertsChannel(): Promise<unknown> {
+  // High importance: an agent waiting on a permission should surface as a banner.
+  alertsChannel ??= Notifications.setNotificationChannelAsync(ALERTS_CHANNEL_ID, {
+    name: i18n.t("settings.general.backgroundConnection.notification.alertsChannel"),
+    importance: Notifications.AndroidImportance.HIGH,
+  });
+  return alertsChannel;
+}
+
+export interface ConnectionNotification {
+  title: string;
+  body?: string;
+  data?: Record<string, unknown>;
+}
+
+/** Shows an alert that arrived over the background connection, routed like a push on tap. */
+export async function presentConnectionNotification(
+  notification: ConnectionNotification,
+): Promise<boolean> {
+  await ensureAlertsChannel();
+  await Notifications.scheduleNotificationAsync({
+    content: {
+      title: notification.title,
+      body: notification.body,
+      data: notification.data ?? {},
+    },
+    trigger: { channelId: ALERTS_CHANNEL_ID },
+  });
+  return true;
+}
+
+/** Android 13+ hides every notification, the service's included, until this is granted. */
+export async function ensureConnectionNotificationPermission(): Promise<boolean> {
+  const existing = await Notifications.getPermissionsAsync();
+  if (existing.status === Notifications.PermissionStatus.GRANTED) return true;
+  if (!existing.canAskAgain) return false;
+  const requested = await Notifications.requestPermissionsAsync();
+  return requested.status === Notifications.PermissionStatus.GRANTED;
+}
