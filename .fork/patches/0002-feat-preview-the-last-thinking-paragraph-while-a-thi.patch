+import type { StreamItem, ThoughtItem } from "@/types/stream";
+
+// The view clamps the preview to two lines; this only bounds how much text it lays out.
+export const THOUGHT_PREVIEW_MAX_LENGTH = 240;
+
+const PARAGRAPH_BREAK = /\n\s*\n/;
+
+export interface ThoughtPreviewInput {
+  thought: ThoughtItem;
+  belowItem: StreamItem | null;
+}
+
+// Agents often end a thinking group with a note to the user (what they found, what they do
+// next) that is never repeated as a reply. Surface that last paragraph while the group is
+// collapsed, unless a reply directly follows and already covers the step.
+export function getThoughtPreview(input: ThoughtPreviewInput): string | null {
+  if (input.thought.status !== "ready" || input.belowItem?.kind === "assistant_message") {
+    return null;
+  }
+  const paragraphs = input.thought.text
+    .split(PARAGRAPH_BREAK)
+    .map((paragraph) => paragraph.replace(/\s+/g, " ").trim())
+    .filter((paragraph) => paragraph.length > 0);
+  const lastParagraph = paragraphs.at(-1);
+  if (!lastParagraph) {
+    return null;
+  }
+  return truncate(lastParagraph);
+}
+
+function truncate(text: string): string {
+  const characters = Array.from(text);
+  if (characters.length <= THOUGHT_PREVIEW_MAX_LENGTH) {
+    return text;
+  }
+  const kept = characters.slice(0, THOUGHT_PREVIEW_MAX_LENGTH - 1).join("");
+  return `${kept.trimEnd()}…`;
+}
