+import { describe, expect, it } from "vitest";
+import type { StreamItem, ThoughtItem } from "@/types/stream";
+import { buildAgentStreamRenderModel } from "./model";
+import { layoutStream } from "./layout";
+import { resolveStreamRenderStrategy } from "./strategy-resolver";
+import { getThoughtPreview, THOUGHT_PREVIEW_MAX_LENGTH } from "./thought-preview";
+
+const TURN_ID = "turn-1";
+
+function at(second: number): Date {
+  return new Date(`2026-01-01T00:00:${second.toString().padStart(2, "0")}.000Z`);
+}
+
+function thought(text: string, status: ThoughtItem["status"] = "ready"): ThoughtItem {
+  return { kind: "thought", id: "thought", text, timestamp: at(2), status, turnId: TURN_ID };
+}
+
+function user(): StreamItem {
+  return { kind: "user_message", id: "user", text: "Go", timestamp: at(1), turnId: TURN_ID };
+}
+
+function assistant(): StreamItem {
+  return {
+    kind: "assistant_message",
+    id: "assistant",
+    text: "Done.",
+    timestamp: at(3),
+    turnId: TURN_ID,
+  };
+}
+
+function toolCall(): StreamItem {
+  return {
+    kind: "tool_call",
+    id: "tool",
+    timestamp: at(3),
+    turnId: TURN_ID,
+    payload: {
+      source: "agent",
+      data: {
+        provider: "claude",
+        callId: "tool",
+        name: "Bash",
+        status: "running",
+        error: null,
+        detail: { type: "unknown", input: null, output: null },
+      },
+    },
+  };
+}
+
+const MULTI_BLOCK_TEXT =
+  "The reducer merges reasoning chunks without a separator.\nCheck the server side next.\n\n" +
+  "确认了：同一消息里的多个思考块被直接拼接。接下来我会在服务端插入段落分隔，再改客户端预览。";
+
+describe("getThoughtPreview", () => {
+  it("previews the last block of a multi-block thought that ends in Chinese", () => {
+    expect(getThoughtPreview({ thought: thought(MULTI_BLOCK_TEXT), belowItem: toolCall() })).toBe(
+      "确认了：同一消息里的多个思考块被直接拼接。接下来我会在服务端插入段落分隔，再改客户端预览。",
+    );
+  });
+
+  it("previews a single-block thought as one line of text", () => {
+    expect(
+      getThoughtPreview({
+        thought: thought("Read the config.\nThen run   the build."),
+        belowItem: toolCall(),
+      }),
+    ).toBe("Read the config. Then run the build.");
+  });
+
+  it("does not preview a thought that a reply directly follows", () => {
+    expect(getThoughtPreview({ thought: thought(MULTI_BLOCK_TEXT), belowItem: assistant() })).toBe(
+      null,
+    );
+  });
+
+  it("previews a thought that a tool call follows", () => {
+    expect(getThoughtPreview({ thought: thought("Run the tests."), belowItem: toolCall() })).toBe(
+      "Run the tests.",
+    );
+  });
+
+  it("previews a thought that ends the turn", () => {
+    expect(getThoughtPreview({ thought: thought("Nothing left to do."), belowItem: null })).toBe(
+      "Nothing left to do.",
+    );
+    expect(getThoughtPreview({ thought: thought("Nothing left to do."), belowItem: user() })).toBe(
+      "Nothing left to do.",
+    );
+  });
+
+  it("does not preview an empty thought", () => {
+    expect(getThoughtPreview({ thought: thought(""), belowItem: toolCall() })).toBe(null);
+    expect(getThoughtPreview({ thought: thought(" \n\n \n"), belowItem: toolCall() })).toBe(null);
+  });
+
+  it("ignores trailing blank paragraphs", () => {
+    expect(
+      getThoughtPreview({ thought: thought("First.\n\nSecond.\n\n  \n"), belowItem: null }),
+    ).toBe("Second.");
+  });
+
+  it("does not preview a thought that is still streaming", () => {
+    expect(
+      getThoughtPreview({ thought: thought("Still thinking", "loading"), belowItem: null }),
+    ).toBe(null);
+  });
+
+  it("truncates a long last paragraph with an ellipsis", () => {
+    const paragraph = "思".repeat(THOUGHT_PREVIEW_MAX_LENGTH + 50);
+
+    const preview = getThoughtPreview({
+      thought: thought(`Earlier.\n\n${paragraph}`),
+      belowItem: toolCall(),
+    });
+
+    expect(preview).toBe(`${"思".repeat(THOUGHT_PREVIEW_MAX_LENGTH - 1)}…`);
+  });
+
+  it("does not split a surrogate pair when truncating", () => {
+    const paragraph = "😀".repeat(THOUGHT_PREVIEW_MAX_LENGTH + 1);
+
+    const preview = getThoughtPreview({ thought: thought(paragraph), belowItem: toolCall() });
+
+    expect(preview).toBe(`${"😀".repeat(THOUGHT_PREVIEW_MAX_LENGTH - 1)}…`);
+  });
+});
+
+describe("thought preview in a laid-out stream", () => {
+  function previewsFor(items: StreamItem[], platform: "web" | "native"): Array<string | null> {
+    const model = buildAgentStreamRenderModel({
+      isTurnActive: false,
+      activeTurnStartedAt: null,
+      tail: items,
+      head: [],
+      platform,
+      isMobileBreakpoint: platform === "native",
+    });
+    const layout = layoutStream({
+      strategy: resolveStreamRenderStrategy({
+        platform,
+        isMobileBreakpoint: platform === "native",
+      }),
+      isTurnActive: false,
+      history: model.segments.historyMounted,
+      liveHead: model.segments.liveHead,
+      timingByAssistantId: model.turnTiming.byAssistantId,
+    });
+    return [...layout.history, ...layout.liveHead].flatMap((row) =>
+      row.item.kind === "thought"
+        ? [getThoughtPreview({ thought: row.item, belowItem: row.belowItem })]
+        : [],
+    );
+  }
+
+  it.each(["web", "native"] as const)(
+    "hides the preview only when a reply follows the thought (%s)",
+    (platform) => {
+      expect(previewsFor([user(), thought("Plan."), assistant()], platform)).toEqual([null]);
+      expect(previewsFor([user(), thought("Plan."), toolCall()], platform)).toEqual(["Plan."]);
+    },
+  );
+});
