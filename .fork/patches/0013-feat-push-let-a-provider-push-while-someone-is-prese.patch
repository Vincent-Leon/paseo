+  /**
+   * Pushes an alert that `recipient` gets in-app through the providers that deliver while someone
+   * is present, leaving out the recipient's own registration.
+   */
+  private pushWhilePresent(
+    payload: PushPayload,
+    recipient: WebSocketLike | undefined,
+    logContext: { agentId: string } | { terminalId: string },
+  ): void {
+    const skip = recipient
+      ? (this.sessions.get(recipient)?.session.getClientPushToken(recipient) ?? null)
