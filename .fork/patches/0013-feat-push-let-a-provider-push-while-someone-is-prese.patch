diff --git a/packages/server/src/server/push/index.test.ts b/packages/server/src/server/push/index.test.ts
index 1cd4c1baa..f837f51ef 100644
--- a/packages/server/src/server/push/index.test.ts
+++ b/packages/server/src/server/push/index.test.ts
@@ -4,7 +4,7 @@ import path from "node:path";
 import type pino from "pino";
 import { afterEach, describe, expect, test } from "vitest";
 
-import { createPushNotifications } from "./index.js";
+import { createPushNotifications, type PushProvider, type PushSubscription } from "./index.js";
 
 function createLogger(): pino.Logger {
   const logger = {
@@ -64,4 +64,54 @@ describe("push notifications", () => {
 
     expect(deliveries).toEqual([]);
   });
+
+  test("while someone is present, only providers that ask for it push, and not to that device", async () => {
+    const home = mkdtempSync(path.join(tmpdir(), "paseo-push-notifications-"));
+    homes.push(home);
+    const delivered: Record<string, string[][]> = { huawei: [], expo: [] };
+    const provider = (providerId: string, deliversWhilePresent: boolean): PushProvider => ({
+      providerId,
+      deliversWhilePresent,
+      deliver: async (subscriptions: readonly PushSubscription[]) => {
+        delivered[providerId].push(subscriptions.map((subscription) => subscription.token));
+        return {};
+      },
+    });
+    const pushNotifications = createPushNotifications({
+      logger: createLogger(),
+      filePath: path.join(home, "push-tokens.json"),
+      now: () => Date.parse("2026-08-10T00:00:00.000Z"),
+      providers: [provider("huawei", true), provider("expo", false)],
+    });
+    pushNotifications.renew("phone", "huawei");
+    pushNotifications.renew("laptop", "huawei");
+    pushNotifications.renew("ExponentPushToken[tablet]", "expo");
+    const payload = { title: "Agent finished", body: "Done" };
+
+    await pushNotifications.sendWhilePresent(payload, { provider: "huawei", token: " laptop " });
+    expect(delivered).toEqual({ huawei: [["phone"]], expo: [] });
+
+    await pushNotifications.send(payload);
+    expect(delivered).toEqual({
+      huawei: [["phone"], ["phone", "laptop"]],
+      expo: [["ExponentPushToken[tablet]"]],
+    });
+  });
+
+  test("while someone is present, a host without such a provider pushes nothing", async () => {
+    const home = mkdtempSync(path.join(tmpdir(), "paseo-push-notifications-"));
+    homes.push(home);
+    const deliveries: string[][] = [];
+    const pushNotifications = createPushNotifications({
+      logger: createLogger(),
+      filePath: path.join(home, "push-tokens.json"),
+      now: () => Date.parse("2026-08-10T00:00:00.000Z"),
+      deliver: async (tokens) => deliveries.push(tokens),
+    });
+
+    pushNotifications.renew("ExponentPushToken[present-device]");
+    await pushNotifications.sendWhilePresent({ title: "Agent finished", body: "Done" }, null);
+
+    expect(deliveries).toEqual([]);
+  });
 });
diff --git a/packages/server/src/server/push/index.ts b/packages/server/src/server/push/index.ts
index 767d7f940..d6c6ed55a 100644
--- a/packages/server/src/server/push/index.ts
+++ b/packages/server/src/server/push/index.ts
@@ -22,11 +22,24 @@ export interface PushNotifications {
   renew(token: string, provider?: string, metadata?: Record<string, string>): void;
   revoke(token: string, provider?: string): void;
   send(payload: PushPayload): Promise<void>;
+  /**
+   * Pushes an alert that a present client already gets in-app, through the providers that
+   * deliver while someone is present. `skip` is that client's own registration, so the device
+   * showing the alert does not get it twice.
+   */
+  sendWhilePresent(payload: PushPayload, skip: PushRegistration | null): Promise<void>;
   /** Provider ids this daemon can actually deliver through, for capability gating. */
   listDeliverableProviders(): string[];
 }
 
-export type PushNotificationSender = Pick<PushNotifications, "send">;
+export interface PushRegistration {
+  provider: string;
+  token: string;
+}
+
+// A sender without sendWhilePresent pushes only when nobody is present.
+export type PushNotificationSender = Pick<PushNotifications, "send"> &
+  Partial<Pick<PushNotifications, "sendWhilePresent">>;
 
 export function createPushNotifications(options: {
   logger: pino.Logger;
@@ -39,18 +52,64 @@ export function createPushNotifications(options: {
    * bypasses provider-reported revocations.
    */
   deliver?: (tokens: string[], payload: PushPayload) => Promise<void>;
+  /** Replaces the manifest's providers, for tests. */
+  providers?: readonly PushProvider[];
 }): PushNotifications {
   const now = options.now ?? Date.now;
   const store = new PushTokenStore(options.logger, options.filePath, now, PUSH_TOKEN_LEASE_MS);
 
   const providers = new Map<string, PushProvider>();
-  for (const entry of PUSH_PROVIDERS) {
-    const provider = entry.create({
-      logger: options.logger,
-      config: options.providerConfig?.[entry.providerId],
-    });
-    // A null provider means this host holds no credentials for that channel.
-    if (provider) providers.set(entry.providerId, provider);
+  if (options.providers) {
+    for (const provider of options.providers) providers.set(provider.providerId, provider);
+  } else {
+    for (const entry of PUSH_PROVIDERS) {
+      const provider = entry.create({
+        logger: options.logger,
+        config: options.providerConfig?.[entry.providerId],
+      });
+      // A null provider means this host holds no credentials for that channel.
+      if (provider) providers.set(entry.providerId, provider);
+    }
+  }
+
+  async function deliver(
+    byProvider: Map<string, PushSubscription[]>,
+    payload: PushPayload,
+    whilePresent: boolean,
+  ): Promise<void> {
+    const tokenCount = Array.from(byProvider.values()).reduce(
+      (total, subscriptions) => total + subscriptions.length,
+      0,
+    );
+    options.logger.info({ tokenCount, whilePresent }, "Sending push notification");
+    if (tokenCount === 0) return;
+
+    if (options.deliver) {
+      const tokens = Array.from(byProvider.values())
+        .flat()
+        .map((subscription: PushSubscription) => subscription.token);
+      await options.deliver(tokens, payload);
+      return;
+    }
+
+    // One failing channel must not stop the others, so each is awaited
+    // independently and its revocations applied on its own.
+    await Promise.all(
+      Array.from(byProvider, async ([providerId, subscriptions]) => {
+        const provider = providers.get(providerId);
+        if (!provider) {
+          options.logger.warn(
+            { provider: providerId, tokenCount: subscriptions.length },
+            "No provider registered for stored tokens",
+          );
+          return;
+        }
+        const result = await provider.deliver(subscriptions, payload);
+        for (const token of result.revokedTokens ?? []) {
+          store.revokeToken(providerId, token);
+        }
+      }),
+    );
   }
 
   return {
@@ -64,40 +123,21 @@ export function createPushNotifications(options: {
       return Array.from(providers.keys());
     },
     async send(payload) {
-      const byProvider = store.getActiveSubscriptionsByProvider();
-      const tokenCount = Array.from(byProvider.values()).reduce(
-        (total, subscriptions) => total + subscriptions.length,
-        0,
-      );
-      options.logger.info({ tokenCount }, "Sending push notification");
-      if (tokenCount === 0) return;
-
-      if (options.deliver) {
-        const tokens = Array.from(byProvider.values())
-          .flat()
-          .map((subscription: PushSubscription) => subscription.token);
-        await options.deliver(tokens, payload);
-        return;
+      await deliver(store.getActiveSubscriptionsByProvider(), payload, false);
+    },
+    async sendWhilePresent(payload, skip) {
+      const skipToken = skip?.token.trim();
+      const byProvider = new Map<string, PushSubscription[]>();
+      for (const [providerId, subscriptions] of store.getActiveSubscriptionsByProvider()) {
+        if (!providers.get(providerId)?.deliversWhilePresent) continue;
+        const kept = subscriptions.filter(
+          (subscription) => !(providerId === skip?.provider && subscription.token === skipToken),
+        );
+        if (kept.length > 0) byProvider.set(providerId, kept);
       }
-
-      // One failing channel must not stop the others, so each is awaited
-      // independently and its revocations applied on its own.
-      await Promise.all(
-        Array.from(byProvider, async ([providerId, subscriptions]) => {
-          const provider = providers.get(providerId);
-          if (!provider) {
-            options.logger.warn(
-              { provider: providerId, tokenCount: subscriptions.length },
-              "No provider registered for stored tokens",
-            );
-            return;
-          }
-          const result = await provider.deliver(subscriptions, payload);
-          for (const token of result.revokedTokens ?? []) {
-            store.revokeToken(providerId, token);
-          }
-        }),
-      );
+      // Most hosts have no such provider; stay as quiet as a daemon that never pushes here.
+      if (byProvider.size === 0) return;
+      await deliver(byProvider, payload, true);
     },
   };
 }
