diff --git a/packages/app/src/stores/sidebar-collapsed-sections-store/state.ts b/packages/app/src/stores/sidebar-collapsed-sections-store/state.ts
index cf92e600b..d04e8b309 100644
--- a/packages/app/src/stores/sidebar-collapsed-sections-store/state.ts
+++ b/packages/app/src/stores/sidebar-collapsed-sections-store/state.ts
@@ -52,6 +52,22 @@ export function toggleWorkspaceGroupCollapsed(
   return { ...state, collapsedWorkspaceGroupKeys: next };
 }
 
+export function setWorkspaceGroupsCollapsed(
+  state: CollapsedProjectsState,
+  workspaceGroupKeys: readonly string[],
+  collapsed: boolean,
+): CollapsedProjectsState {
+  const next = new Set(state.collapsedWorkspaceGroupKeys);
+  for (const key of workspaceGroupKeys) {
+    if (collapsed) {
+      next.add(key);
+    } else {
+      next.delete(key);
+    }
+  }
+  return { ...state, collapsedWorkspaceGroupKeys: next };
+}
