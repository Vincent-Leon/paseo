@@ -325,6 +344,48 @@ const STATUS_GROUP_VISIBILITY = {
   getStatusBucket: (workspace: SidebarWorkspaceEntry) => workspace.statusBucket,
 };
 
+function EarlierGroupsHeader({
+  groupKeys,
+  collapsedWorkspaceGroupKeys,
+}: {
+  groupKeys: readonly string[];
+  collapsedWorkspaceGroupKeys: ReadonlySet<string>;
+}) {
+  const { t } = useTranslation();
+  const setWorkspaceGroupsCollapsed = useSidebarCollapsedSectionsStore(
+    (state) => state.setWorkspaceGroupsCollapsed,
+  );
+  // Expand only once everything is folded; any open group means the next press folds them all.
+  const allCollapsed = groupKeys.every((key) => collapsedWorkspaceGroupKeys.has(key));
+  const handlePress = useCallback(
+    () => setWorkspaceGroupsCollapsed(groupKeys, !allCollapsed),
+    [allCollapsed, groupKeys, setWorkspaceGroupsCollapsed],
+  );
+  return (
+    <SidebarSectionHeader
+      title={t("sidebar.activity.earlier.title")}
+      testID="sidebar-activity-earlier"
+    >
+      <ToolbarButton
+        label={
+          allCollapsed
+            ? t("sidebar.activity.earlier.expandAll")
+            : t("sidebar.activity.earlier.collapseAll")
+        }
+        compact
+        onPress={handlePress}
+        testID="sidebar-activity-earlier-toggle"
+      >
+        <DensityIcon
+          icon={allCollapsed ? ChevronsUpDown : ChevronsDownUp}
+          size="xs"
+          color="foregroundMuted"
+        />
+      </ToolbarButton>
+    </SidebarSectionHeader>
+  );
+}
