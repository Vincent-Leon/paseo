 import { WorkspaceRenameModal } from "@/components/workspace-rename-modal";
 import { useWorkspaceClipboardActions } from "@/hooks/use-workspace-clipboard-actions";
@@ -300,26 +305,82 @@ function StatusGroupList({
   supportsPinningByServerId: ReadonlyMap<string, boolean>;
   onToggleWorkspacePin: ToggleSidebarWorkspacePin;
 }) {
+  // Activity grouping ends with one group per project for work finished before its window.
+  // Those sit under one Earlier heading that folds or unfolds all of them at once.
+  const earlierGroupKeys = useMemo(
+    () => groups.filter((group) => group.leading.kind === "project").map((group) => group.key),
+    [groups],
+  );
+  const firstEarlierKey = earlierGroupKeys[0] ?? null;
   return (
     <>
       {groups.map((group) => (
-        <StatusGroupRows
-          key={group.key}
-          group={group}
-          collapsed={collapsedWorkspaceGroupKeys.has(group.key)}
-          projectIconByProjectViewKey={projectIconByProjectViewKey}
-          shortcutIndex={shortcutIndex}
-          showShortcutBadges={showShortcutBadges}
-          onWorkspacePress={onWorkspacePress}
-          hostBadgeByServerId={hostBadgeByServerId}
-          supportsPinningByServerId={supportsPinningByServerId}
-          onToggleWorkspacePin={onToggleWorkspacePin}
-        />
+        <Fragment key={group.key}>
+          {group.key === firstEarlierKey ? (
+            <EarlierGroupsHeader
+              groupKeys={earlierGroupKeys}
+              collapsedWorkspaceGroupKeys={collapsedWorkspaceGroupKeys}
+            />
+          ) : null}
+          <StatusGroupRows
+            group={group}
+            collapsed={collapsedWorkspaceGroupKeys.has(group.key)}
+            projectIconByProjectViewKey={projectIconByProjectViewKey}
+            shortcutIndex={shortcutIndex}
+            showShortcutBadges={showShortcutBadges}
+            onWorkspacePress={onWorkspacePress}
+            hostBadgeByServerId={hostBadgeByServerId}
+            supportsPinningByServerId={supportsPinningByServerId}
+            onToggleWorkspacePin={onToggleWorkspacePin}
+          />
+        </Fragment>
       ))}
     </>
   );
 }
 
+function EarlierGroupsHeader({
+  groupKeys,
+  collapsedWorkspaceGroupKeys,
+}: {
+  groupKeys: readonly string[];
+  collapsedWorkspaceGroupKeys: ReadonlySet<string>;
+}) {
+  const { t } = useTranslation();
+  const setWorkspaceGroupsCollapsed = useSidebarCollapsedSectionsStore(
+    (state) => state.setWorkspaceGroupsCollapsed,
+  );
+  // Expand only once everything is folded; any open group means the next press folds them all.
+  const allCollapsed = groupKeys.every((key) => collapsedWorkspaceGroupKeys.has(key));
+  const handlePress = useCallback(
+    () => setWorkspaceGroupsCollapsed(groupKeys, !allCollapsed),
+    [allCollapsed, groupKeys, setWorkspaceGroupsCollapsed],
+  );
+  return (
+    <SidebarSectionHeader
+      title={t("sidebar.activity.earlier.title")}
+      testID="sidebar-activity-earlier"
+    >
+      <ToolbarButton
+        label={
+          allCollapsed
+            ? t("sidebar.activity.earlier.expandAll")
+            : t("sidebar.activity.earlier.collapseAll")
+        }
+        compact
+        onPress={handlePress}
+        testID="sidebar-activity-earlier-toggle"
+      >
+        <DensityIcon
+          icon={allCollapsed ? ChevronsUpDown : ChevronsDownUp}
+          size="xs"
+          color="foregroundMuted"
+        />
+      </ToolbarButton>
+    </SidebarSectionHeader>
+  );
+}
