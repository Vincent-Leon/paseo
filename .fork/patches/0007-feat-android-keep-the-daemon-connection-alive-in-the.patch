diff --git a/packages/app/src/screens/settings/general/background-connection-section.tsx b/packages/app/src/screens/settings/general/background-connection-section.tsx
new file mode 100644
index 000000000..b96df53aa
--- /dev/null
+++ b/packages/app/src/screens/settings/general/background-connection-section.tsx
@@ -0,0 +1,91 @@
+import { useCallback, useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import {
+  backgroundConnection,
+  startBackgroundConnection,
+} from "@/background-connection/connection";
+import {
+  SettingsAction,
+  SettingsCard,
+  SettingsSection,
+  SettingsSwitch,
+} from "@/components/settings";
+import { useAppVisible } from "@/hooks/use-app-visible";
+import { useAppSettings } from "@/hooks/use-settings";
+
+/** Android only: the module is null elsewhere, and so is this section. */
+export function BackgroundConnectionSection() {
+  if (!backgroundConnection) return null;
+  return <BackgroundConnectionCard module={backgroundConnection} />;
+}
+
+function BackgroundConnectionCard({
+  module,
+}: {
+  module: NonNullable<typeof backgroundConnection>;
+}) {
+  const { t } = useTranslation();
+  const { settings, updateSettings } = useAppSettings();
+  const enabled = settings.keepConnectedInBackground;
+  const [startError, setStartError] = useState<string | null>(null);
+  const appVisible = useAppVisible();
+  const [ignoringBatteryOptimizations, setIgnoringBatteryOptimizations] = useState(() =>
+    module.isIgnoringBatteryOptimizations(),
+  );
+  // The system's exemption dialog covers Paseo, so coming back to the front is when the
+  // answer may have changed.
+  useEffect(() => {
+    if (appVisible) setIgnoringBatteryOptimizations(module.isIgnoringBatteryOptimizations());
+  }, [appVisible, module]);
+
+  const requestExemption = useCallback(() => module.requestIgnoreBatteryOptimizations(), [module]);
+
+  const toggle = useCallback(
+    (next: boolean) => {
+      if (!next) {
+        module.stop();
+        setStartError(null);
+        void updateSettings({ keepConnectedInBackground: false });
+        return;
+      }
+      try {
+        startBackgroundConnection(module, t);
+      } catch (error) {
+        setStartError(
+          t("settings.general.backgroundConnection.startFailed", {
+            message: error instanceof Error ? error.message : String(error),
+          }),
+        );
+        return;
+      }
+      setStartError(null);
+      void updateSettings({ keepConnectedInBackground: true });
+      if (!module.isIgnoringBatteryOptimizations()) requestExemption();
+    },
+    [module, requestExemption, t, updateSettings],
+  );
+
+  return (
+    <SettingsSection title={t("settings.general.backgroundConnection.title")}>
+      <SettingsCard>
+        <SettingsSwitch
+          label={t("settings.general.backgroundConnection.label")}
+          hint={t("settings.general.backgroundConnection.hint")}
+          error={startError}
+          value={enabled}
+          onValueChange={toggle}
+          testID="settings-background-connection"
+        />
+        {enabled && !ignoringBatteryOptimizations ? (
+          <SettingsAction
+            label={t("settings.general.backgroundConnection.battery.label")}
+            hint={t("settings.general.backgroundConnection.battery.hint")}
+            actionLabel={t("settings.general.backgroundConnection.battery.action")}
+            onPress={requestExemption}
+            testID="settings-background-connection-battery"
+          />
+        ) : null}
+      </SettingsCard>
+    </SettingsSection>
+  );
+}
