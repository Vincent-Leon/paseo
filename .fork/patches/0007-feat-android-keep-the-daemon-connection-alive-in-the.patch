@@ -0,0 +1,42 @@
+package sh.paseo.connection
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.PowerManager
+import android.provider.Settings
+import expo.modules.kotlin.exception.Exceptions
+import expo.modules.kotlin.modules.Module
+import expo.modules.kotlin.modules.ModuleDefinition
+
+class PaseoBackgroundConnectionModule : Module() {
+  override fun definition() = ModuleDefinition {
+    Name("PaseoBackgroundConnection")
+
+    // Android allows starting a foreground service only while the app is in the foreground, so
+    // JavaScript calls this from the settings switch and at launch, never from the background.
+    Function("start") { title: String, text: String, channelName: String ->
+      ConnectionService.start(context(), title, text, channelName)
+    }
+
+    Function("stop") { ConnectionService.stop(context()) }
+
+    // Doze and vendor battery managers can still restrict an optimized app's network with the
+    // screen off; the exemption is what keeps the screen-off connection reliable.
+    Function("isIgnoringBatteryOptimizations") {
+      val context = context()
+      context.getSystemService(PowerManager::class.java).isIgnoringBatteryOptimizations(context.packageName)
+    }
+
+    Function("requestIgnoreBatteryOptimizations") {
+      val context = context()
+      val intent =
+        Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:${context.packageName}"))
+          .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+      context.startActivity(intent)
+    }
+  }
+
+  private fun context(): Context =
+    appContext.reactContext?.applicationContext ?: throw Exceptions.ReactContextLost()
+}
