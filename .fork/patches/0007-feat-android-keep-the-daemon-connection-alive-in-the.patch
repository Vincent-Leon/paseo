new file mode 100644
index 000000000..d820327a7
--- /dev/null
+++ b/packages/app/src/background-connection/connection.ts
@@ -0,0 +1,26 @@
+import type { TFunction } from "i18next";
+import { requireOptionalNativeModule } from "expo-modules-core";
+
+interface BackgroundConnectionModule {
+  start(title: string, text: string, channelName: string): void;
+  stop(): void;
+  isIgnoringBatteryOptimizations(): boolean;
+  requestIgnoreBatteryOptimizations(): void;
+}
+
+/**
+ * The Android foreground service that keeps the app process, and with it the daemon connection,
+ * alive in the background. Null on every other platform, which is what hides the setting there.
+ */
+export const backgroundConnection = requireOptionalNativeModule<BackgroundConnectionModule>(
+  "PaseoBackgroundConnection",
+);
+
+/** Throws when Android refuses the service, for example because the app is not in front. */
+export function startBackgroundConnection(module: BackgroundConnectionModule, t: TFunction): void {
+  module.start(
+    t("settings.general.backgroundConnection.notification.title"),
+    t("settings.general.backgroundConnection.notification.text"),
+    t("settings.general.backgroundConnection.notification.channel"),
+  );
+}
diff --git a/packages/app/src/background-connection/sync.tsx b/packages/app/src/background-connection/sync.tsx
new file mode 100644
index 000000000..ce292612d
--- /dev/null
+++ b/packages/app/src/background-connection/sync.tsx
@@ -0,0 +1,32 @@
+import { useEffect } from "react";
+import { useTranslation } from "react-i18next";
+import { useAppSettings } from "@/hooks/use-settings";
+import { backgroundConnection, startBackgroundConnection } from "./connection";
+
+/**
+ * Starts the background connection at launch when it is turned on, and follows the setting after
+ * that. Launch is the moment that counts: Android only lets the app start the service from the
+ * foreground, and the process it keeps alive is this one.
+ */
+export function BackgroundConnectionSync() {
+  const { t } = useTranslation();
+  const { settings, isLoading } = useAppSettings();
+  const enabled = settings.keepConnectedInBackground;
+
+  useEffect(() => {
+    if (!backgroundConnection || isLoading) return;
+    if (!enabled) {
+      backgroundConnection.stop();
+      return;
+    }
+    try {
+      startBackgroundConnection(backgroundConnection, t);
+    } catch (error) {
+      // The settings switch reports a failed start where the user turned it on; at launch there
+      // is no surface to report on, and the switch shows the next attempt's error.
+      console.warn("[BackgroundConnection] Failed to start", error);
+    }
+  }, [enabled, isLoading, t]);
+
+  return null;
+}
