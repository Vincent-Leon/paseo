@@ -0,0 +1,84 @@
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { harmonyHost } from "@/harmony/host";
+import { assertCoversExports } from "@/harmony/variant";
+import type * as Base from "./index";
+import type { RevokePushNotificationsInput, StartPushNotificationsInput } from "./internal/types";
+
+/** The daemon's Push Kit provider id; one name on the wire, in config and in the manifest. */
+const PROVIDER = "huawei";
+
+interface PushTokenResult {
+  token: string | null;
+  detail: string;
+}
+
+let tokenRequest: Promise<string | null> | null = null;
+
+/**
+ * Push Kit's token, asked for once per launch. Its tokenUpdate event does not
+ * fire on phones, so asking again on the next launch is how a rotation is
+ * noticed.
+ */
+function pushToken(): Promise<string | null> {
+  tokenRequest ??= harmonyHost
+    .request<PushTokenResult | null>("push.token")
+    .then((result) => {
+      if (!result?.token) console.warn("[HarmonyPush] No Push Kit token:", result?.detail);
+      return result?.token ?? null;
+    })
+    .catch((error) => {
+      console.warn("[HarmonyPush] Push Kit token request failed", error);
+      tokenRequest = null;
+      return null;
+    });
+  return tokenRequest;
+}
+
+/** Only a host holding Push Kit credentials can route the token; others never get it. */
+function routesHuawei(client: DaemonClient): boolean {
+  return client.getLastServerInfoMessage()?.features?.pushProviders?.includes(PROVIDER) === true;
+}
+
+export const startPushNotifications: typeof Base.startPushNotifications = (
+  input: StartPushNotificationsInput,
+) => {
+  let stopped = false;
+  let token: string | null = null;
+  const register = () => {
+    if (!stopped && token && input.client.isConnected && routesHuawei(input.client)) {
+      input.client.registerPushToken(token, { provider: PROVIDER });
+    }
+  };
+
+  void pushToken().then((resolved) => {
+    token = resolved;
+    register();
+    return undefined;
+  });
+
+  const unsubscribe = input.client.subscribeConnectionStatus((state) => {
+    if (state.status === "connected") register();
+  });
+
+  return () => {
+    stopped = true;
+    unsubscribe();
+  };
+};
+
+export const revokePushNotifications: typeof Base.revokePushNotifications = async (
+  input: RevokePushNotificationsInput,
+) => {
+  const client = input.client;
+  if (!client?.isConnected || !routesHuawei(client)) return;
+  if (client.getLastServerInfoMessage()?.features?.pushTokenRevocation !== true) return;
+  const token = await pushToken();
+  if (!token) return;
+  try {
+    await client.unregisterPushToken(token, { provider: PROVIDER });
+  } catch (error) {
+    console.warn("[HarmonyPush] Failed to revoke the Push Kit token", error);
+  }
+};
+
+assertCoversExports<typeof Base, typeof import("./index.harmony")>();
