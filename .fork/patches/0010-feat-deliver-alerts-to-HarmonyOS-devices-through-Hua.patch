new file mode 100644
index 000000000..1cd8f0c7c
--- /dev/null
+++ b/packages/server/src/server/push/providers/huawei/provider.ts
@@ -0,0 +1,298 @@
+import { constants, createPrivateKey, sign, type KeyObject } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import type pino from "pino";
+import { z } from "zod";
+
+import type {
+  PushDeliveryResult,
+  PushPayload,
+  PushProvider,
+  PushProviderFactoryOptions,
+  PushSubscription,
+} from "../../push-provider.js";
+
+/**
+ * Huawei Push Kit, the only channel that reaches a HarmonyOS device whose app is
+ * not running. The HarmonyOS app registers its Push Kit token under this id.
+ */
+export const HUAWEI_PROVIDER_ID = "huawei";
+
+const DEFAULT_BASE_URL = "https://push-api.cloud.huawei.com";
+const TOKEN_AUDIENCE = "https://oauth-login.cloud.huawei.com/oauth2/v3/token";
+// Huawei accepts a service-account JWT for up to an hour; renew well before.
+const JWT_LIFETIME_SECONDS = 3600;
+const JWT_RENEW_AFTER_MS = 50 * 60 * 1000;
+// Test messages may target at most 10 tokens per request, regular ones 1000.
+const TEST_BATCH_SIZE = 10;
+const BATCH_SIZE = 1000;
+const MESSAGE_TTL_SECONDS = 24 * 60 * 60;
+
+const SUCCESS = "80000000";
+const PARTIAL_SUCCESS = "80100000";
+const ALL_TOKENS_INVALID = "80300007";
+
+/**
+ * The want parameter the HarmonyOS shell reads a tap's data from. A tap on a
+ * push opens the app with clickAction.data as want parameters, so the data
+ * travels as the same JSON string the shell's own local notifications carry.
+ */
+const NOTIFICATION_DATA_PARAM = "paseoNotificationData";
+
+/** The key file AppGallery Connect hands out for a service account. */
+const ServiceAccountKeySchema = z.object({
+  project_id: z.string().min(1),
+  key_id: z.string().min(1),
+  private_key: z.string().min(1),
+  sub_account: z.string().min(1),
+});
+
+const OptionsSchema = z.object({
+  // A category other than MARKETING only counts once the app holds Push Kit's
+  // self-classification entitlement for it. Without one Huawei files every
+  // message as marketing: silent, and a handful per device per day.
+  category: z.string().min(1).default("WORK"),
+  // Test messages skip the per-device caps, up to 1000 a day per project, which
+  // is what makes a personal build usable before the entitlement is granted.
+  // Set false once it is.
+  testMessage: z.boolean().default(true),
+  baseUrl: z.string().url().optional(),
+});
+
+type HuaweiPushOptions = z.infer<typeof OptionsSchema>;
+
+interface HuaweiProviderConfig {
+  /** Holds service-account.json (the AGC key file) and optionally options.json. */
+  directory: string;
+}
+
+interface HuaweiSendResponse {
+  code?: unknown;
+  msg?: unknown;
+  requestId?: unknown;
+}
+
+function readConfig(config: unknown): HuaweiProviderConfig | null {
+  if (!config || typeof config !== "object") return null;
+  const directory = (config as { directory?: unknown }).directory;
+  return typeof directory === "string" && directory.length > 0 ? { directory } : null;
+}
+
+function readJsonFile(path: string): unknown {
+  return JSON.parse(readFileSync(path, "utf8"));
+}
+
+function base64UrlJson(value: unknown): string {
+  return Buffer.from(JSON.stringify(value)).toString("base64url");
+}
+
+/** A stable 31-bit id per agent or terminal, so a newer alert replaces the older one. */
+export function notifyIdFor(payload: PushPayload): number {
+  const data = payload.data ?? {};
+  const subject = [data.serverId, data.agentId ?? data.terminalId ?? payload.title]
+    .map((part) => (typeof part === "string" ? part : ""))
+    .join(":");
+  let hash = 0;
+  for (let index = 0; index < subject.length; index += 1) {
+    hash = (hash * 31 + subject.charCodeAt(index)) % 2147483647;
+  }
+  return hash;
+}
+
+/** Tokens Huawei reports as permanently invalid in a partial-success response. */
+export function illegalTokensFrom(msg: unknown): string[] {
+  if (typeof msg !== "string") return [];
+  try {
+    const parsed = JSON.parse(msg) as { illegal_tokens?: unknown; illegalTokens?: unknown };
+    const tokens = parsed.illegal_tokens ?? parsed.illegalTokens;
+    return Array.isArray(tokens) ? tokens.filter((token) => typeof token === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+export class HuaweiPushProvider implements PushProvider {
+  readonly providerId = HUAWEI_PROVIDER_ID;
+
+  private readonly logger: pino.Logger;
+  private readonly fetchImpl: typeof fetch;
+  private readonly key: KeyObject;
+  private readonly account: z.infer<typeof ServiceAccountKeySchema>;
+  private readonly options: HuaweiPushOptions;
+  private readonly now: () => number;
+  private cachedJwt: { value: string; issuedAt: number } | null = null;
+
+  constructor(input: {
+    logger: pino.Logger;
+    account: z.infer<typeof ServiceAccountKeySchema>;
+    options: HuaweiPushOptions;
+    fetch?: typeof fetch;
+    now?: () => number;
+  }) {
+    this.logger = input.logger.child({ component: "push-provider", provider: HUAWEI_PROVIDER_ID });
+    this.account = input.account;
+    this.key = createPrivateKey(input.account.private_key);
+    this.options = input.options;
+    this.fetchImpl = input.fetch ?? fetch;
+    this.now = input.now ?? Date.now;
+  }
+
+  /**
+   * Builds the provider from `<directory>/service-account.json`, or returns null
+   * when there is none: this host then holds no Huawei credentials, and the
+   * HarmonyOS app is told not to register a token with it.
+   */
+  static fromFactoryOptions(options: PushProviderFactoryOptions): HuaweiPushProvider | null {
+    const config = readConfig(options.config);
+    if (!config) return null;
+    let raw: unknown;
+    try {
+      raw = readJsonFile(join(config.directory, "service-account.json"));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") {
+        options.logger.error({ err: error }, "Unreadable Huawei Push Kit service account key");
+      }
+      return null;
+    }
+    const account = ServiceAccountKeySchema.safeParse(raw);
+    if (!account.success) {
+      options.logger.error(
+        { issues: account.error.issues.map((issue) => issue.path.join(".")) },
+        "Huawei Push Kit service account key is missing fields",
+      );
+      return null;
+    }
+
+    let rawOptions: unknown = {};
+    try {
+      rawOptions = readJsonFile(join(config.directory, "options.json"));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") {
+        options.logger.error({ err: error }, "Unreadable Huawei Push Kit options; using defaults");
+      }
+    }
+    const parsedOptions = OptionsSchema.safeParse(rawOptions);
+    if (!parsedOptions.success) {
+      options.logger.error("Invalid Huawei Push Kit options; using defaults");
+    }
+
+    try {
+      return new HuaweiPushProvider({
+        logger: options.logger,
+        account: account.data,
+        options: parsedOptions.success ? parsedOptions.data : OptionsSchema.parse({}),
+        fetch: options.fetch,
+      });
+    } catch (error) {
+      options.logger.error({ err: error }, "Huawei Push Kit private key is not a valid key");
+      return null;
+    }
+  }
+
+  async deliver(
+    subscriptions: readonly PushSubscription[],
+    payload: PushPayload,
+  ): Promise<PushDeliveryResult> {
+    if (subscriptions.length === 0) return {};
+    const tokens = subscriptions.map((subscription) => subscription.token);
+    const size = this.options.testMessage ? TEST_BATCH_SIZE : BATCH_SIZE;
+    const batches: string[][] = [];
+    for (let index = 0; index < tokens.length; index += size) {
+      batches.push(tokens.slice(index, index + size));
+    }
+    const revoked = await Promise.all(batches.map((batch) => this.sendBatch(batch, payload)));
+    return { revokedTokens: revoked.flat() };
+  }
+
+  /**
+   * A service-account JWT, used directly as the bearer token: PS256 over the
+   * key file's key_id and sub_account, for Huawei's OAuth token endpoint.
+   */
+  private jwt(): string {
+    const nowMs = this.now();
+    if (this.cachedJwt && nowMs - this.cachedJwt.issuedAt < JWT_RENEW_AFTER_MS) {
+      return this.cachedJwt.value;
+    }
+    const issuedAt = Math.floor(nowMs / 1000);
+    const signingInput = `${base64UrlJson({ kid: this.account.key_id, typ: "JWT", alg: "PS256" })}.${base64UrlJson(
+      {
+        iss: this.account.sub_account,
+        aud: TOKEN_AUDIENCE,
+        iat: issuedAt,
+        exp: issuedAt + JWT_LIFETIME_SECONDS,
+      },
+    )}`;
+    const signature = sign("sha256", Buffer.from(signingInput), {
+      key: this.key,
+      padding: constants.RSA_PKCS1_PSS_PADDING,
+      saltLength: constants.RSA_PSS_SALTLEN_DIGEST,
+    }).toString("base64url");
+    const value = `${signingInput}.${signature}`;
+    this.cachedJwt = { value, issuedAt: nowMs };
+    return value;
+  }
+
+  private messageFor(tokens: string[], payload: PushPayload): unknown {
+    return {
+      payload: {
+        notification: {
+          category: this.options.category,
+          title: payload.title,
+          body: payload.body,
+          notifyId: notifyIdFor(payload),
+          // 0 opens the app's main ability, which hands the data to the page.
+          clickAction: {
+            actionType: 0,
+            data: { [NOTIFICATION_DATA_PARAM]: JSON.stringify(payload.data ?? {}) },
+          },
+        },
+      },
+      target: { token: tokens },
+      pushOptions: { testMessage: this.options.testMessage, ttl: MESSAGE_TTL_SECONDS },
+    };
+  }
+
+  private async sendBatch(tokens: string[], payload: PushPayload): Promise<string[]> {
+    const baseUrl = (this.options.baseUrl ?? DEFAULT_BASE_URL).replace(/\/+$/, "");
+    const url = `${baseUrl}/v3/${encodeURIComponent(this.account.project_id)}/messages:send`;
+    try {
+      const response = await this.fetchImpl(url, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          Authorization: `Bearer ${this.jwt()}`,
+          // 0: a notification message the system shows on its own.
+          "push-type": "0",
+        },
+        body: JSON.stringify(this.messageFor(tokens, payload)),
+      });
+      const result = (await response.json().catch(() => ({}))) as HuaweiSendResponse;
+      const code = typeof result.code === "string" ? result.code : String(result.code ?? "");
+      if (response.ok && code === SUCCESS) return [];
+      if (code === PARTIAL_SUCCESS) {
+        const illegal = illegalTokensFrom(result.msg);
+        this.logger.warn(
+          { invalid: illegal.length, sent: tokens.length },
+          "Push Kit dropped tokens",
+        );
+        return illegal;
+      }
+      if (code === ALL_TOKENS_INVALID) {
+        this.logger.warn({ sent: tokens.length }, "Push Kit rejected every token");
+        return tokens;
+      }
+      if (code === "80200003" || response.status === 401) {
+        // The JWT was refused; issue a fresh one next time.
+        this.cachedJwt = null;
+      }
+      this.logger.error(
+        { status: response.status, code, msg: result.msg, requestId: result.requestId },
+        "Push Kit API error",
+      );
+      return [];
+    } catch (error) {
+      this.logger.error({ err: error }, "Failed to send Push Kit notifications");
+      return [];
+    }
+  }
+}
