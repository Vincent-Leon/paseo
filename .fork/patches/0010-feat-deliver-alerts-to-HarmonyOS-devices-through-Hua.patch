+import { constants, generateKeyPairSync, verify, type KeyObject } from "node:crypto";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import type pino from "pino";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { HuaweiPushProvider, illegalTokensFrom, notifyIdFor } from "./provider.js";
+
+function createLogger(): pino.Logger {
+  const logger = {
+    child: () => logger,
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: () => undefined,
+  };
+  return logger as unknown as pino.Logger;
+}
+
+const keys = generateKeyPairSync("rsa", { modulusLength: 2048 });
+const account = {
+  project_id: "101234567",
+  key_id: "key-1",
+  private_key: keys.privateKey.export({ type: "pkcs8", format: "pem" }).toString(),
+  sub_account: "sub-1",
+};
+
+interface SentRequest {
+  url: string;
+  headers: Record<string, string>;
+  body: {
+    payload: { notification: Record<string, unknown> };
+    target: { token: string[] };
+    pushOptions: { testMessage: boolean; ttl: number };
+  };
+}
+
+function fakeFetch(responses: Array<{ status?: number; body: unknown }>) {
+  const sent: SentRequest[] = [];
+  const fetchImpl = (async (url: string, init: RequestInit) => {
+    sent.push({
+      url,
+      headers: init.headers as Record<string, string>,
+      body: JSON.parse(String(init.body)),
+    });
+    const next = responses[Math.min(sent.length - 1, responses.length - 1)];
+    return new Response(JSON.stringify(next.body), { status: next.status ?? 200 });
+  }) as unknown as typeof fetch;
+  return { sent, fetchImpl };
+}
+
+function decodeJwt(header: string, publicKey: KeyObject) {
+  const jwt = header.replace(/^Bearer /, "");
+  const [head, body, signature] = jwt.split(".");
+  const valid = verify(
+    "sha256",
+    Buffer.from(`${head}.${body}`),
+    {
+      key: publicKey,
+      padding: constants.RSA_PKCS1_PSS_PADDING,
+      saltLength: constants.RSA_PSS_SALTLEN_DIGEST,
+    },
+    Buffer.from(signature, "base64url"),
+  );
+  return {
+    valid,
+    header: JSON.parse(Buffer.from(head, "base64url").toString()),
+    claims: JSON.parse(Buffer.from(body, "base64url").toString()),
+  };
+}
+
+const payload = {
+  title: "Fix the tests",
+  body: "Finished",
+  data: { serverId: "srv", agentId: "a1", reason: "finished" },
+};
+
+function subscriptions(count: number) {
+  return Array.from({ length: count }, (_, index) => ({ provider: "huawei", token: `t${index}` }));
+}
+
+describe("HuaweiPushProvider", () => {
+  const directories: string[] = [];
+  afterEach(() => {
+    for (const directory of directories.splice(0))
+      rmSync(directory, { recursive: true, force: true });
+  });
+
+  function directoryWith(files: Record<string, string>): string {
+    const directory = mkdtempSync(path.join(tmpdir(), "paseo-huawei-push-"));
+    directories.push(directory);
+    for (const [name, content] of Object.entries(files)) {
+      writeFileSync(path.join(directory, name), content);
+    }
+    return directory;
+  }
+
+  test("is unavailable without a service account key, or with a broken one", () => {
+    const logger = createLogger();
+    expect(HuaweiPushProvider.fromFactoryOptions({ logger, config: undefined })).toBeNull();
+    expect(
+      HuaweiPushProvider.fromFactoryOptions({ logger, config: { directory: directoryWith({}) } }),
+    ).toBeNull();
+    const broken = directoryWith({
+      "service-account.json": JSON.stringify({ ...account, key_id: undefined }),
+    });
+    expect(
+      HuaweiPushProvider.fromFactoryOptions({ logger, config: { directory: broken } }),
+    ).toBeNull();
+  });
+
+  test("sends a notification message signed with the service account", async () => {
+    const { sent, fetchImpl } = fakeFetch([{ body: { code: "80000000", msg: "Success" } }]);
+    const provider = HuaweiPushProvider.fromFactoryOptions({
+      logger: createLogger(),
+      config: {
+        directory: directoryWith({ "service-account.json": JSON.stringify(account) }),
+      },
+      fetch: fetchImpl,
+    });
+
+    const result = await provider!.deliver(subscriptions(1), payload);
+
+    expect(result.revokedTokens).toEqual([]);
+    expect(sent).toHaveLength(1);
+    const [request] = sent;
+    expect(request.url).toBe("https://push-api.cloud.huawei.com/v3/101234567/messages:send");
+    expect(request.headers["push-type"]).toBe("0");
+    const jwt = decodeJwt(request.headers.Authorization, keys.publicKey);
+    expect(jwt.valid).toBe(true);
+    expect(jwt.header).toEqual({ kid: "key-1", typ: "JWT", alg: "PS256" });
+    expect(jwt.claims).toMatchObject({
+      iss: "sub-1",
+      aud: "https://oauth-login.cloud.huawei.com/oauth2/v3/token",
+    });
+    expect(jwt.claims.exp - jwt.claims.iat).toBe(3600);
+    expect(request.body.target.token).toEqual(["t0"]);
+    expect(request.body.pushOptions.testMessage).toBe(true);
+    expect(request.body.payload.notification).toMatchObject({
+      category: "WORK",
+      title: "Fix the tests",
+      body: "Finished",
+      notifyId: notifyIdFor(payload),
+      clickAction: {
+        actionType: 0,
+        data: { paseoNotificationData: JSON.stringify(payload.data) },
+      },
+    });
+  });
+
+  test("takes its category and test mode from options.json", async () => {
+    const { sent, fetchImpl } = fakeFetch([{ body: { code: "80000000" } }]);
+    const provider = HuaweiPushProvider.fromFactoryOptions({
+      logger: createLogger(),
+      config: {
+        directory: directoryWith({
+          "service-account.json": JSON.stringify(account),
+          "options.json": JSON.stringify({ category: "IM", testMessage: false }),
+        }),
+      },
+      fetch: fetchImpl,
+    });
+
+    await provider!.deliver(subscriptions(12), payload);
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0].body.payload.notification.category).toBe("IM");
+    expect(sent[0].body.pushOptions.testMessage).toBe(false);
+  });
+
+  test("keeps test messages to ten tokens a request", async () => {
+    const { sent, fetchImpl } = fakeFetch([{ body: { code: "80000000" } }]);
+    const provider = new HuaweiPushProvider({
+      logger: createLogger(),
+      account,
+      options: { category: "WORK", testMessage: true },
+      fetch: fetchImpl,
+    });
+
+    await provider.deliver(subscriptions(23), payload);
+
+    expect(sent.map((request) => request.body.target.token.length)).toEqual([10, 10, 3]);
+  });
+
+  test("reports the tokens Huawei says are gone, and only those", async () => {
+    const partial = fakeFetch([
+      {
+        body: {
+          code: "80100000",
+          msg: JSON.stringify({ success: 1, failure: 1, illegal_tokens: ["t1"] }),
+        },
+      },
+    ]);
+    const allInvalid = fakeFetch([
+      { body: { code: "80300007", msg: "All the tokens are invalid" } },
+    ]);
+    const outage = fakeFetch([{ status: 503, body: { code: "81000001", msg: "Internal error" } }]);
+    const build = (fetchImpl: typeof fetch) =>
+      new HuaweiPushProvider({
+        logger: createLogger(),
+        account,
+        options: { category: "WORK", testMessage: true },
+        fetch: fetchImpl,
+      });
+
+    expect(
+      (await build(partial.fetchImpl).deliver(subscriptions(2), payload)).revokedTokens,
+    ).toEqual(["t1"]);
+    expect(
+      (await build(allInvalid.fetchImpl).deliver(subscriptions(2), payload)).revokedTokens,
+    ).toEqual(["t0", "t1"]);
+    expect(
+      (await build(outage.fetchImpl).deliver(subscriptions(2), payload)).revokedTokens,
+    ).toEqual([]);
+  });
+
+  test("reuses the JWT within the hour and issues a new one after", async () => {
+    let now = 1_700_000_000_000;
+    const { sent, fetchImpl } = fakeFetch([{ body: { code: "80000000" } }]);
+    const provider = new HuaweiPushProvider({
+      logger: createLogger(),
+      account,
+      options: { category: "WORK", testMessage: true },
+      fetch: fetchImpl,
+      now: () => now,
+    });
+
+    await provider.deliver(subscriptions(1), payload);
+    now += 10 * 60 * 1000;
+    await provider.deliver(subscriptions(1), payload);
+    now += 50 * 60 * 1000;
+    await provider.deliver(subscriptions(1), payload);
+
+    const authorizations = sent.map((request) => request.headers.Authorization);
+    expect(authorizations[1]).toBe(authorizations[0]);
+    expect(authorizations[2]).not.toBe(authorizations[0]);
+  });
+});
+
+describe("Push Kit helpers", () => {
+  test("keys a notification by its agent or terminal", () => {
+    const finished = {
+      title: "a",
+      body: "",
+      data: { serverId: "s", agentId: "x", reason: "finished" },
+    };
+    const permission = {
+      title: "b",
+      body: "",
+      data: { serverId: "s", agentId: "x", reason: "permission" },
+    };
+    const other = { title: "a", body: "", data: { serverId: "s", agentId: "y" } };
+
+    expect(notifyIdFor(finished)).toBe(notifyIdFor(permission));
+    expect(notifyIdFor(finished)).not.toBe(notifyIdFor(other));
+    expect(notifyIdFor(finished)).toBeGreaterThanOrEqual(0);
+    expect(notifyIdFor(finished)).toBeLessThan(2147483647);
+  });
+
+  test("reads illegal tokens out of a partial-success message", () => {
+    expect(illegalTokensFrom(JSON.stringify({ illegal_tokens: ["a", 1, "b"] }))).toEqual([
+      "a",
+      "b",
+    ]);
+    expect(illegalTokensFrom("not json")).toEqual([]);
+    expect(illegalTokensFrom(undefined)).toEqual([]);
+  });
+});
