diff --git a/packages/app/src/screens/settings/general/fold-rotation-section.harmony.tsx b/packages/app/src/screens/settings/general/fold-rotation-section.harmony.tsx
new file mode 100644
index 000000000..1fb762a57
--- /dev/null
+++ b/packages/app/src/screens/settings/general/fold-rotation-section.harmony.tsx
@@ -0,0 +1,53 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useCallback } from "react";
+import { useTranslation } from "react-i18next";
+import { SettingsCard, SettingsSection, SettingsSwitch } from "@/components/settings";
+import { useFetchQuery } from "@/data/query";
+import { harmonyHost } from "@/harmony/host";
+import { assertCoversExports } from "@/harmony/variant";
+import type * as Base from "./fold-rotation-section";
+
+/** What the shell's `rotation.status` and `rotation.set` answer. */
+interface RotationStatus {
+  foldable: boolean;
+  folded: boolean;
+  lockWhenFolded: boolean;
+}
+
+const ROTATION_QUERY_KEY = ["harmony", "rotation"] as const;
+
+// The shell owns the choice and applies it before the page loads; this shows and changes it.
+export function FoldRotationSection() {
+  const { t } = useTranslation();
+  const queryClient = useQueryClient();
+  const { data: status } = useFetchQuery({
+    queryKey: ROTATION_QUERY_KEY,
+    queryFn: () => harmonyHost.request<RotationStatus>("rotation.status"),
+    dataShape: "value",
+    // Read afresh whenever the page opens; only this switch changes it otherwise.
+    staleTimeMs: 0,
+  });
+  const { mutate } = useMutation({
+    mutationFn: (lockWhenFolded: boolean) =>
+      harmonyHost.request<RotationStatus>("rotation.set", { lockWhenFolded }),
+    onSuccess: (next) => queryClient.setQueryData(ROTATION_QUERY_KEY, next),
+  });
+  const change = useCallback((lockWhenFolded: boolean) => mutate(lockWhenFolded), [mutate]);
+
+  if (!status?.foldable) return null;
+  return (
+    <SettingsSection title={t("settings.general.foldRotation.title")}>
+      <SettingsCard>
+        <SettingsSwitch
+          label={t("settings.general.foldRotation.label")}
+          hint={t("settings.general.foldRotation.hint")}
+          value={status.lockWhenFolded}
+          onValueChange={change}
+          testID="settings-fold-rotation"
+        />
+      </SettingsCard>
+    </SettingsSection>
+  );
+}
+
+assertCoversExports<typeof Base, typeof import("./fold-rotation-section.harmony")>();
diff --git a/packages/app/src/screens/settings/general/fold-rotation-section.tsx b/packages/app/src/screens/settings/general/fold-rotation-section.tsx
