--- /dev/null
+++ b/packages/app/src/screens/settings/general/fold-rotation-section.tsx
@@ -0,0 +1,7 @@
+/**
+ * Whether a folded phone stays in portrait. Only the HarmonyOS shell can hold the window's
+ * orientation, so every other build renders nothing; see the `.harmony` variant.
+ */
+export function FoldRotationSection(): null {
+  return null;
+}
