+import type { TFunction } from "i18next";
+import { buildStatusGroups, compareStatusRows } from "@/hooks/sidebar-status-view-model";
+import type { SidebarWorkspaceEntry } from "@/hooks/use-sidebar-workspaces-list";
+import type { SidebarActivityWindow } from "@/stores/sidebar-view-store";
+import { statusWorkspaceGroups, type SidebarWorkspaceGroup } from "./sidebar-labels";
+
+const HOUR_MS = 3_600_000;
+
+const DONE_LABEL_KEYS = {
+  "3h": "sidebar.activity.doneWithin.threeHours",
+  "12h": "sidebar.activity.doneWithin.twelveHours",
+  today: "sidebar.activity.doneWithin.today",
+} as const satisfies Record<SidebarActivityWindow, string>;
+
+export interface ActivityGroupsInput {
+  workspaces: SidebarWorkspaceEntry[];
+  projectNamesByViewKey: Map<string, string>;
+  window: SidebarActivityWindow;
+  now: number;
+  t: TFunction;
+}
+
+/** The earliest finish time that still counts as recent. "today" starts at local midnight. */
+export function activityWindowStart(window: SidebarActivityWindow, now: number): number {
+  switch (window) {
+    case "3h":
+      return now - 3 * HOUR_MS;
+    case "12h":
+      return now - 12 * HOUR_MS;
+    case "today":
+      return new Date(now).setHours(0, 0, 0, 0);
+  }
+}
+
+/**
+ * Activity grouping: everything still live in its status bucket, the work that finished inside
+ * the window under one Done group, and everything finished before it folded into one group per
+ * project, the project with the most recent finish first.
+ *
+ * A done workspace's `statusEnteredAt` is when it entered the done bucket, which is when it
+ * finished. A done workspace without one has no known finish, so it counts as older.
+ */
+export function buildActivityGroups(input: ActivityGroupsInput): SidebarWorkspaceGroup[] {
+  const { workspaces, projectNamesByViewKey, t } = input;
+  const windowStart = activityWindowStart(input.window, input.now);
+  const live: SidebarWorkspaceEntry[] = [];
+  const recent: SidebarWorkspaceEntry[] = [];
+  const olderByProject = new Map<string, SidebarWorkspaceEntry[]>();
+
+  for (const workspace of workspaces) {
+    if (workspace.statusBucket !== "done") {
+      live.push(workspace);
+      continue;
+    }
+    const finishedAt = workspace.statusEnteredAt?.getTime() ?? null;
+    if (finishedAt !== null && finishedAt >= windowStart) {
+      recent.push(workspace);
+      continue;
+    }
+    const rows = olderByProject.get(workspace.projectViewKey) ?? [];
+    rows.push(workspace);
+    olderByProject.set(workspace.projectViewKey, rows);
+  }
+
+  const groups = statusWorkspaceGroups(buildStatusGroups(live, projectNamesByViewKey, t));
+
+  if (recent.length > 0) {
+    recent.sort((a, b) => compareStatusRows(a, b, projectNamesByViewKey));
+    groups.push({
+      key: "activity:done",
+      label: t(DONE_LABEL_KEYS[input.window]),
+      rows: recent,
+      leading: { kind: "status", bucket: "done" },
+    });
+  }
+
+  const projectGroups: SidebarWorkspaceGroup[] = [];
+  for (const [projectViewKey, rows] of olderByProject) {
+    rows.sort((a, b) => compareStatusRows(a, b, projectNamesByViewKey));
+    projectGroups.push({
+      key: `activity:project:${projectViewKey}`,
+      label: projectNamesByViewKey.get(projectViewKey) ?? rows[0].projectName,
+      rows,
+      leading: { kind: "project", projectViewKey },
+    });
+  }
+  // Each group's rows are already newest first, so its first row is its most recent finish.
+  projectGroups.sort((a, b) => compareStatusRows(a.rows[0], b.rows[0], projectNamesByViewKey));
+
+  return [...groups, ...projectGroups];
+}
