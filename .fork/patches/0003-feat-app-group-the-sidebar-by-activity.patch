@@ -0,0 +1,171 @@
+import { i18n } from "@/i18n/i18next";
+import { describe, expect, it } from "vitest";
+import type { SidebarWorkspaceEntry } from "@/hooks/use-sidebar-workspaces-list";
+import { buildActivityGroups } from "./activity-groups";
+
+// Built from local fields so "today" means the same calendar day in every test time zone.
+const NOW = new Date(2026, 9, 22, 10, 0).getTime();
+const HOUR = 3_600_000;
+
+function ws(
+  id: string,
+  options: {
+    bucket?: SidebarWorkspaceEntry["statusBucket"];
+    enteredAt?: number | null;
+    project?: string;
+  } = {},
+): SidebarWorkspaceEntry {
+  const project = options.project ?? "alpha";
+  const enteredAt = options.enteredAt === undefined ? NOW : options.enteredAt;
+  return {
+    workspaceKey: `srv:${id}`,
+    serverId: "srv",
+    workspaceId: id,
+    projectViewKey: project,
+    projectName: project === "alpha" ? "Alpha" : "Beta",
+    projectKind: "git",
+    workspaceKind: "worktree",
+    name: id,
+    workspaceDirectory: "",
+    workspaceDirectoryLabel: "",
+    title: null,
+    currentBranch: null,
+    statusBucket: options.bucket ?? "done",
+    statusEnteredAt: enteredAt === null ? null : new Date(enteredAt),
+    archivingAt: null,
+    diffStat: null,
+    prHint: null,
+    archiveHasUncommittedChanges: null,
+    archiveUnpushedCommitCount: null,
+    scripts: [],
+    hasRunningScripts: false,
+    labels: [],
+  };
+}
+
+function summarize(workspaces: SidebarWorkspaceEntry[], window: "3h" | "12h" | "today") {
+  return buildActivityGroups({
+    workspaces,
+    projectNamesByViewKey: new Map([
+      ["alpha", "Alpha"],
+      ["beta", "Beta"],
+    ]),
+    window,
+    now: NOW,
+    t: i18n.t,
+  }).map((group) => ({
+    key: group.key,
+    label: group.label,
+    leading: group.leading,
+    rows: group.rows.map((row) => row.workspaceId),
+  }));
+}
+
+describe("buildActivityGroups", () => {
+  it("puts live work first, then today's finished work, then older work by project", () => {
+    const groups = summarize(
+      [
+        ws("old-alpha", { enteredAt: NOW - 30 * HOUR }),
+        ws("working", { bucket: "running", enteredAt: NOW - 5 * HOUR }),
+        ws("finished-this-morning", { enteredAt: NOW - 2 * HOUR, project: "beta" }),
+        ws("waiting", { bucket: "needs_input", enteredAt: NOW - HOUR }),
+        ws("old-beta", { enteredAt: NOW - 50 * HOUR, project: "beta" }),
+        ws("unread", { bucket: "attention", enteredAt: NOW - 20 * HOUR }),
+      ],
+      "today",
+    );
+
+    expect(groups).toEqual([
+      {
+        key: "needs_input",
+        label: "Needs input",
+        leading: { kind: "status", bucket: "needs_input" },
+        rows: ["waiting"],
+      },
+      {
+        key: "attention",
+        label: "Ready to review",
+        leading: { kind: "status", bucket: "attention" },
+        rows: ["unread"],
+      },
+      {
+        key: "running",
+        label: "Working",
+        leading: { kind: "status", bucket: "running" },
+        rows: ["working"],
+      },
+      {
+        key: "activity:done",
+        label: "Done today",
+        leading: { kind: "status", bucket: "done" },
+        rows: ["finished-this-morning"],
+      },
+      {
+        key: "activity:project:alpha",
+        label: "Alpha",
+        leading: { kind: "project", projectViewKey: "alpha" },
+        rows: ["old-alpha"],
+      },
+      {
+        key: "activity:project:beta",
+        label: "Beta",
+        leading: { kind: "project", projectViewKey: "beta" },
+        rows: ["old-beta"],
+      },
+    ]);
+  });
+
+  it("starts today at local midnight, so last night's work is already older", () => {
+    const groups = summarize(
+      [
+        ws("just-after-midnight", { enteredAt: new Date(2026, 9, 22, 0, 5).getTime() }),
+        ws("just-before-midnight", { enteredAt: new Date(2026, 9, 21, 23, 55).getTime() }),
+      ],
+      "today",
+    );
+
+    expect(groups.map((group) => [group.key, group.rows])).toEqual([
+      ["activity:done", ["just-after-midnight"]],
+      ["activity:project:alpha", ["just-before-midnight"]],
+    ]);
+  });
+
+  it("keeps a rolling window of the chosen length", () => {
+    const workspaces = [
+      ws("two-hours-ago", { enteredAt: NOW - 2 * HOUR }),
+      ws("five-hours-ago", { enteredAt: NOW - 5 * HOUR }),
+    ];
+
+    expect(summarize(workspaces, "3h").map((group) => [group.label, group.rows])).toEqual([
+      ["Done in the last 3 hours", ["two-hours-ago"]],
+      ["Alpha", ["five-hours-ago"]],
+    ]);
+    expect(summarize(workspaces, "12h").map((group) => [group.label, group.rows])).toEqual([
+      ["Done in the last 12 hours", ["two-hours-ago", "five-hours-ago"]],
+    ]);
+  });
+
+  it("orders older projects by their latest finished workspace, newest first", () => {
+    const groups = summarize(
+      [
+        ws("alpha-old", { enteredAt: NOW - 90 * HOUR }),
+        ws("beta-newer", { enteredAt: NOW - 40 * HOUR, project: "beta" }),
+        ws("alpha-newer", { enteredAt: NOW - 30 * HOUR }),
+      ],
+      "today",
+    );
+
+    expect(groups.map((group) => [group.key, group.rows])).toEqual([
+      ["activity:project:alpha", ["alpha-newer", "alpha-old"]],
+      ["activity:project:beta", ["beta-newer"]],
+    ]);
+  });
+
+  it("treats finished work with no recorded time as older", () => {
+    const groups = summarize([ws("unknown", { enteredAt: null })], "12h");
+
+    expect(groups.map((group) => [group.key, group.rows])).toEqual([
+      ["activity:project:alpha", ["unknown"]],
+    ]);
+  });
+});
