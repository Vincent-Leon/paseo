   return used == null ? null : 100 - used;
 }
 
+/** The part of a window or balance that places it in time. */
+export type UsagePeriod = Pick<UsageWindow, "resetsAt" | "durationSeconds">;
+
+/**
+ * How far `now` is through the period, 0–100, or null when the period cannot be placed: it reports
+ * no length or reset, or `now` is outside it. A kept report whose reset has passed belongs to a
+ * window that already rolled over, so it gets no position rather than a full one.
+ */
+export function elapsedPercent(period: UsagePeriod, now: number): number | null {
+  const { resetsAt, durationSeconds } = period;
+  if (resetsAt == null || durationSeconds == null || durationSeconds <= 0) return null;
+  const end = Date.parse(resetsAt);
+  if (Number.isNaN(end)) return null;
+  const length = durationSeconds * 1000;
+  const elapsed = now - (end - length);
+  if (elapsed < 0 || now >= end) return null;
+  return (elapsed / length) * 100;
+}
+
+/**
+ * The elapsed-time position beside the percent a window shows: elapsed time next to used, time
+ * left next to remaining, so the marker and the fill always measure the same thing.
+ */
+export function displayElapsedPercent(
+  period: UsagePeriod,
+  displayAs: UsageDisplayAs,
+  now: number,
+): number | null {
+  const elapsed = elapsedPercent(period, now);
+  if (elapsed === null || displayAs === "used") return elapsed;
+  return 100 - elapsed;
+}
